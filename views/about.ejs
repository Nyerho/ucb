<%- include('partials/layouts/main-start') -%>

<section class="hero" style="padding:60px 0 40px;">
  <div class="container">
    <div style="max-width:800px;margin:0 auto;text-align:center;">
      <span class="section-eyebrow">🇦🇺 About United Credit Bank</span>
      <h1 style="font-size:3rem;margin:16px 0;">42 years of banking, built for Australians.</h1>
      <p class="hero-subtitle" style="margin:0 auto 24px;">From a small Sydney credit union in 1984 to one of Australia's most trusted banks — we've grown, but our values haven't changed.</p>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
