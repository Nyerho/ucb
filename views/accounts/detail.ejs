<% const pageScripts = ['/js/transfers.js']; %>
<%- include('../partials/layouts/user-start') -%>

<div style="margin-bottom:20px;">
  <a href="/accounts" class="btn btn-outline btn-sm" style="margin-bottom:12px;">← Back to Accounts</a>
  <div class="account-card">
    <div class="account-card-header">
      <div class="account-type">
        <div class="account-type-icon">
          <% if (account.account_type.includes('High')) { %>🏆
          <% } else if (account.account_type.includes('Term')) { %>🔒
          <% } else if (account.account_type.includes('Business')) { %>🏢
          <% } else { %>💳<% } %>
        </div>
        <div>
          <div class="account-name"><%= account.account_type %></div>
          <div class="account-number">BSB <%= account.bsb %> • <%= account.account_number %></div>
          <div style="font-size:0.82rem;color:var(--text-light);margin-top:2px;">Account Name: <%= account.account_name %></div>
        </div>
      </div>
      <div class="account-balance">
        <div class="account-balance-label">Available</div>
        <div class="account-balance-value"><%= currency(account.available_balance) %></div>
        <div style="font-size:0.85rem;color:var(--text-light);text-align:right;">Ledger: <%= currency(account.balance) %></div>
      </div>
    </div>
    <div class="account-meta">
      <div class="account-meta-item">
        <span class="account-meta-label">Branch</span>
        <span class="account-meta-value"><%= account.branch %></span>
      </div>
      <div class="account-meta-item">
        <span class="account-meta-label">Currency</span>
        <span class="account-meta-value"><%= account.currency %> 🇦🇺</span>
      </div>
      <div class="account-meta-item">
        <span class="account-meta-label">Interest Rate</span>
        <span class="account-meta-value" style="color:var(--primary);font-weight:700;"><%= parseFloat(account.interest_rate).toFixed(2) %>% p.a.</span>
      </div>
      <div class="account-meta-item">
        <span class="account-meta-label">Opened</span>
        <span class="account-meta-value"><%= moment(account.opened_date).format('DD MMM YYYY') %></span>
      </div>
      <div class="account-meta-item">
        <span class="account-meta-label">Status</span>
        <span class="status-badge status-<%= account.status %>"><%= account.status %></span>
      </div>
    </div>
    <div class="account-actions">
      <a href="/transfers/local?from=<%= account.id %>" class="btn btn-primary btn-sm">↔️ Transfer Money</a>
      <a href="/billpay/pay?account_id=<%= account.id %>" class="btn btn-outline btn-sm">📄 Pay Bill</a>
      <a href="/billpay/deposit/new?account_id=<%= account.id %>" class="btn btn-success btn-sm">⬇️ Deposit</a>
      <a href="/billpay/withdraw/new?account_id=<%= account.id %>" class="btn btn-warning btn-sm">⬆️ Withdraw</a>
      <a href="/user/statements?account=<%= account.id %>" class="btn btn-light btn-sm">📊 Statement</a>
    </div>
  </div>
</div>

<div class="grid-3" style="margin-bottom:20px;">
  <div class="stat-card">
    <div class="stat-header">
      <div>
        <div class="stat-label">Current Balance</div>
        <div class="stat-value" style="color:var(--primary);"><%= currency(account.balance) %></div>
      </div>
      <div class="stat-icon stat-icon-primary">💰</div>
    </div>
    <div class="stat-change">As of today</div>
  </div>
  <div class="stat-card">
    <div class="stat-header">
      <div>
        <div class="stat-label">Total Deposits</div>
        <div class="stat-value" style="color:var(--success);">+<%= currency(totalDeposits) %></div>
      </div>
      <div class="stat-icon stat-icon-success">⬇️</div>
    </div>
    <div class="stat-change up">All time credits</div>
  </div>
  <div class="stat-card">
    <div class="stat-header">
      <div>
        <div class="stat-label">Total Withdrawals</div>
        <div class="stat-value" style="color:var(--danger);">-<%= currency(totalWithdrawals) %></div>
      </div>
      <div class="stat-icon stat-icon-warning">⬆️</div>
    </div>
    <div class="stat-change down">All time debits</div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">📋 Recent Transactions</h3>
    <a href="/user/statements?account=<%= account.id %>" class="btn btn-outline btn-sm">View Full Statement</a>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Type & Description</th>
          <th>Reference</th>
          <th style="text-align:right;">Amount</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (transactions.length === 0) { %>
          <tr><td colspan="5"><div class="empty-state" style="padding:40px 20px;"><div class="empty-state-icon">📋</div><h4>No transactions yet</h4><p>Your first transaction will appear here.</p></div></td></tr>
        <% } %>
        <% transactions.forEach(tx => { 
          const isOut = ['withdrawal','local_transfer','international_transfer','bill_payment','loan_payment','admin_adjustment'].includes(tx.transaction_type) && parseFloat(tx.amount) < 0 || ['withdrawal','local_transfer','international_transfer','bill_payment','loan_payment'].includes(tx.transaction_type);
          const amt = Math.abs(parseFloat(tx.amount));
          const displayType = tx.transaction_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        %>
          <tr style="cursor:pointer;" onclick="location.href='/transfers/<%= tx.id %>'">
            <td><%= moment(tx.created_at).format('DD MMM YYYY HH:mm') %></td>
            <td>
              <div style="font-weight:600;font-size:0.9rem;"><%= tx.recipient_name || tx.description || displayType %></div>
              <div style="font-size:0.8rem;color:var(--text-light);"><%= displayType %></div>
            </td>
            <td style="font-family:monospace;font-size:0.85rem;"><%= tx.reference || '—' %></td>
            <td style="text-align:right;">
              <div style="font-weight:700;color:<%= isOut ? 'var(--danger)' : 'var(--success)' %>">
                <%= isOut ? '-' : '+' %><%= currency(amt) %>
              </div>
            </td>
            <td><span class="status-badge status-<%= tx.status %>"><%= tx.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layouts/user-end', { pageScripts }) -%>


