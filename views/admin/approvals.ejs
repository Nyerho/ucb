<%- include('../partials/layouts/admin-start') -%>

<%
  const pendingTotal = pendingKYC.length + pendingTransfers.length + pendingCards.length + pendingLoans.length + pendingBills.length;
  const queues = [
    { key: 'kyc', title: 'KYC review', records: pendingKYC },
    { key: 'transfers', title: 'Pending transfers, deposits, and withdrawals', records: pendingTransfers },
    { key: 'cards', title: 'Card applications', records: pendingCards },
    { key: 'loans', title: 'Loan applications', records: pendingLoans },
    { key: 'bills', title: 'Bill payments', records: pendingBills }
  ];
%>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
  <div><h2 style="margin:0;">Pending workflows</h2><p style="margin:4px 0 0;color:var(--text-gray);">Review real Firestore records. Every decision requires an administrator reason and is written with its audit event in a Firestore transaction.</p></div>
  <span class="status-badge status-pending" style="padding:8px 14px;font-size:0.85rem;"><%= pendingTotal %> pending</span>
</div>
<div class="alert alert-warning" style="margin-bottom:20px;"><span class="alert-icon">!</span><div class="alert-content"><div class="alert-title">Manual settlement and provider boundary</div>
  <p class="alert-message" style="margin:0;">Approval records an administrative decision; it does not call a bank, biller, card issuer, or lender. For transfers, bills, deposits, withdrawals, and loan disbursements, enter the already-verified external settlement/funding reference. Card approvals remain marked for manual issuer fulfillment. Open the actual Firebase Storage files before approving KYC.</p></div></div>

<% queues.forEach(queue => { %>
  <section class="card" style="margin-bottom:20px;">
    <div class="card-header"><h3 class="card-title"><%= queue.title %> · <%= queue.records.length %></h3><% if (section === queue.key) { %><a href="/admin/approvals">Show all</a><% } else { %><a href="/admin/approvals?section=<%= queue.key %>">Filter</a><% } %></div>
    <div class="card-body" style="padding:0;">
      <% if (!queue.records.length) { %><div class="empty-state" style="padding:24px;">No pending records.</div><% } %>
      <% queue.records.forEach(record => { const amount = Number(record.amount ?? record.principal_amount ?? record.loan_amount ?? 0); const loanAccounts = record.customer_accounts || []; const needsLoanAccount = queue.key === 'loans' && !record.account_id; const settlementRequired = ['transfers','bills','loans'].includes(queue.key); %>
        <div style="padding:18px 20px;border-bottom:1px solid var(--border);display:grid;grid-template-columns:minmax(190px,1fr) minmax(240px,1.3fr) minmax(300px,1.5fr);gap:18px;align-items:start;">
          <div>
            <strong><%= record.user_name || (`User #${record.user_id || 'unknown'}`) %></strong>
            <div style="font-size:0.8rem;color:var(--text-light);">UID <%= record.user_id || '—' %></div>
            <div style="font-size:0.8rem;color:var(--text-light);">Record #<%= record.id %> · <%= record.status || 'pending' %></div>
            <% if (record.account_number) { %><div style="font-size:0.8rem;color:var(--text-light);">Account <%= record.account_number %> · <%= record.account_name || '' %></div><% } %>
          </div>
          <div style="font-size:0.88rem;">
            <% if (queue.key === 'kyc') { %>
              <strong><%= record.document_type || 'Identity document' %></strong><div>Submitted <%= moment(record.submitted_at || record.created_at).format('DD MMM YYYY') %></div>
              <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
                <% if (record.has_document_front) { %><a href="/kyc/<%= encodeURIComponent(record.id) %>/document/front" target="_blank" rel="noopener">Download front</a><% } %>
                <% if (record.has_document_back) { %><a href="/kyc/<%= encodeURIComponent(record.id) %>/document/back" target="_blank" rel="noopener">Download back</a><% } %>
                <% if (record.has_document_selfie) { %><a href="/kyc/<%= encodeURIComponent(record.id) %>/document/selfie" target="_blank" rel="noopener">Download selfie</a><% } %>
              </div>
            <% } else if (queue.key === 'transfers') { %>
              <strong><%= String(record.transaction_type || 'transaction').replace(/_/g,' ') %></strong> · <%= currency(amount, record.currency || 'AUD') %>
              <div><%= record.description || record.recipient_name || record.recipient_account || '—' %></div><% if (record.reference) { %><div>Customer reference: <%= record.reference %></div><% } %>
              <div><a href="/admin/transactions/<%= encodeURIComponent(record.id) %>">Inspect transaction and ledger</a></div>
            <% } else if (queue.key === 'cards') { %>
              <strong><%= record.card_type || 'Card application' %></strong><div>Account <%= record.account_number || record.account_id || '—' %> · last four <%= record.card_last4 || '—' %></div>
              <div style="color:var(--warning);">Approval records review only; a card issuer has not been contacted.</div>
            <% } else if (queue.key === 'loans') { %>
              <strong><%= record.loan_type || 'Loan application' %></strong><div><%= currency(amount) %> · <%= record.term_months || record.loan_term_months || '—' %> months · <%= Number(record.interest_rate || 0).toFixed(2) %>% p.a.</div>
              <div>Requested purpose: <%= record.purpose || '—' %></div>
            <% } else { %>
              <strong><%= record.biller_name || 'Bill payment' %></strong> · <%= currency(amount) %><div>Customer reference: <%= record.customer_ref || '—' %></div>
              <% if (record.transaction_id) { %><div>Transaction <a href="/admin/transactions/<%= encodeURIComponent(record.transaction_id) %>"><%= record.transaction_id %></a></div><% } %>
            <% } %>
          </div>
          <form method="POST" action="/admin/approvals/<%= queue.key %>/<%= encodeURIComponent(record.id) %>/review" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;align-items:end;">
            <div class="form-group" style="margin:0;"><label class="form-label">Decision</label><select name="action" class="form-select" required><option value="">Choose</option><option value="approve">Approve</option><option value="reject">Reject</option></select></div>
            <% if (queue.key === 'kyc') { %><label style="grid-column:1/-1;display:flex;gap:8px;align-items:flex-start;font-size:0.82rem;"><input type="checkbox" name="documents_reviewed" value="yes"><span>I downloaded and reviewed the required identity documents. This confirmation is required to approve KYC.</span></label><% } %>
            <% if (needsLoanAccount) { %>
              <div class="form-group" style="margin:0;"><label class="form-label">Disbursement account</label><select name="account_id" class="form-select" <%= loanAccounts.length ? 'required' : 'disabled' %>><option value="">Choose an active customer account</option><% loanAccounts.forEach(a => { %><option value="<%= a.id %>"><%= a.account_name || a.account_type %> · <%= a.account_number %></option><% }) %></select></div>
            <% } %>
            <% if (settlementRequired) { %>
              <div class="form-group" style="margin:0;grid-column:1/-1;"><label class="form-label"><%= queue.key === 'loans' ? 'Verified funding / settlement reference' : 'Verified external settlement reference' %> <span style="font-weight:400;">(required to approve)</span></label><input name="settlement_reference" class="form-input" minlength="3" maxlength="120" pattern="[A-Za-z0-9._:/-]+" placeholder="Reference from confirmed external settlement"></div>
            <% } %>
            <div class="form-group" style="margin:0;grid-column:1/-1;"><label class="form-label">Decision reason (required)</label><input name="reason" class="form-input" minlength="8" maxlength="500" required placeholder="At least 8 characters"></div>
            <% if (needsLoanAccount && !loanAccounts.length) { %><p class="form-hint" style="grid-column:1/-1;margin:0;">No active customer account is available. This loan cannot be disbursed until an account is opened.</p><% } %>
            <button type="submit" class="btn btn-primary" <%= needsLoanAccount && !loanAccounts.length ? 'disabled' : '' %> style="grid-column:1/-1;">Record decision</button>
          </form>
        </div>
      <% }) %>
    </div>
  </section>
<% }) %>

<%- include('../partials/layouts/admin-end') -%>
