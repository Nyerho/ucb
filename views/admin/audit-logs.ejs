<%- include('../partials/layouts/admin-start') -%>

<h2 style="margin-bottom:16px;">📜 Audit Logs (500 latest)</h2>

<div class="card">
  <div class="filter-bar">
    <div class="filter-group"><span class="filter-label">Admin</span>
      <select class="form-select"><option value="">All Admins</option><option>System</option></select>
    </div>
    <div class="filter-group"><span class="filter-label">Action</span>
      <select class="form-select">
        <option value="">All</option><option>login</option><option>create_user</option><option>update_user</option>
        <option>freeze_account</option><option>approve_kyc</option><option>approve_transfer</option>
        <option>approve_card</option><option>approve_loan</option><option>balance_adjustment</option>
      </select>
    </div>
    <button class="btn btn-primary btn-sm">🔍 Filter</button>
    <button class="btn btn-outline btn-sm">⬇️ Export CSV</button>
  </div>
  <div class="card-body" style="padding:0;">
    <% if (!auditLogs || auditLogs.length === 0) { %><div class="empty-state" style="padding:50px;">No audit logs yet.</div><% } %>
    <% (auditLogs||[]).forEach(log => { %>
      <div style="padding:16px 24px;border-bottom:1px solid var(--border);display:flex;gap:14px;">
        <div style="width:40px;height:40px;border-radius:50%;flex-shrink:0;
          background:<%= log.action.includes('approve')?'var(--success-light)':log.action.includes('reject')||log.action.includes('freeze')||log.action.includes('delete')?'var(--danger-light)':'var(--primary-alpha)' %>;
          color:<%= log.action.includes('approve')?'var(--success)':log.action.includes('reject')||log.action.includes('freeze')||log.action.includes('delete')?'var(--danger)':'var(--primary)' %>;
          display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.9rem;">
          <%= log.action.charAt(0).toUpperCase() %>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <div style="font-weight:700;font-size:0.95rem;">
              <%= log.action.replace(/_/g,' ').replace(/\b\w/g, l => l.toUpperCase()) %>
              <span class="tag tag-verified" style="margin-left:6px;"><%= log.target_type %> #<%= log.target_id %></span>
            </div>
            <div style="font-size:0.82rem;color:var(--text-light);"><%= moment(log.created_at).format('DD MMM YYYY HH:mm:ss') %></div>
          </div>
          <div style="font-size:0.88rem;color:var(--text-gray);margin-top:4px;"><%= log.details || 'No additional details' %></div>
          <div style="display:flex;gap:14px;margin-top:6px;flex-wrap:wrap;font-size:0.78rem;color:var(--text-light);">
            <span>👤 Admin: <%= log.admin_name || 'Admin #' + (log.admin_id||'System') %></span>
            <span>🌐 IP: <%= log.ip_address || '—' %></span>
            <span>🖥️ UA: <%= (log.user_agent||'').slice(0,60) %></span>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<%- include('../partials/layouts/admin-end') -%>

