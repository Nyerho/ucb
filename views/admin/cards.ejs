<%- include('../partials/layouts/admin-start') -%>

<h2 style="margin-bottom:16px;">Manage Cards <span style="font-size:0.85rem;color:var(--text-light);">(latest 200)</span></h2>
<div class="alert alert-info" style="margin-bottom:20px;"><span class="alert-icon">i</span><div class="alert-content"><div class="alert-title">Issuer boundary</div><p class="alert-message" style="margin:0;">Pending applications can be approved or rejected in the approval queue. Approval is not card issuance; no issuer is connected. Active cards may be frozen, blocked, or marked lost/stolen with a reason. Full card number, CVV, and PIN hash are never rendered here.</p></div></div>

<div class="card">
  <form class="filter-bar" method="GET" action="/admin/cards">
    <div class="filter-group"><label class="filter-label" for="cardSearch">Search</label><input type="text" id="cardSearch" name="search" value="<%= filters.search || '' %>" class="form-input" placeholder="Cardholder, last 4 digits..."></div>
    <div class="filter-group"><span class="filter-label">Type</span>
      <select class="form-select" name="type"><option value="all">All</option><option value="Debit" <%= filters.type === 'Debit' ? 'selected' : '' %>>Debit</option><option value="Credit" <%= filters.type === 'Credit' ? 'selected' : '' %>>Credit</option></select>
    </div>
    <div class="filter-group"><span class="filter-label">Status</span>
      <select class="form-select" name="status">
        <option value="all">All</option><% ['pending','awaiting_issuer','approved','active','frozen','blocked','lost_stolen','rejected'].forEach(s=>{ %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace('_',' / ') %></option><% }) %>
      </select>
    </div>
    <button class="btn btn-primary btn-sm">Filter</button>
  </form>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Cardholder</th><th>Card Type</th><th>Last 4</th><th style="text-align:right;">Limit</th><th>Expiry</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% cards.forEach(c => { const canManage = ['approved','awaiting_issuer','active','frozen'].includes(String(c.status)); const canActivate = c.fulfillment_status === 'issued'; %>
          <tr>
            <td><div style="display:flex;gap:8px;align-items:center;">
              <div class="user-avatar" style="width:32px;height:32px;font-size:0.75rem;"><%= (c.cardholder_name||c.user_name||'?').charAt(0) %></div>
              <div><div style="font-weight:600;font-size:0.88rem;"><%= c.user_name || c.cardholder_name || 'User #' + c.user_id %></div>
                <div style="font-size:0.72rem;color:var(--text-light);"><%= c.cardholder_name %></div></div></div></td>
            <td><strong style="font-size:0.85rem;"><%= c.card_type %></strong></td>
            <td style="font-family:monospace;">•••• <%= c.card_last4 || (c.card_number||'').slice(-4) || '—' %></td>
            <td style="text-align:right;font-weight:700;"><%= currency(c.credit_limit || 0) %></td>
            <td><%= c.expiry_date || 'MM/YY' %></td>
            <td><span class="status-badge status-<%= c.status %>"><%= c.status %></span></td>
            <td>
              <% if (c.status === 'pending') { %><a class="btn btn-primary btn-sm" href="/admin/approvals?section=cards">Review application</a>
              <% } else if (canManage) { %>
                <form method="POST" action="/admin/cards/<%= encodeURIComponent(c.id) %>/status" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                  <select name="status" class="form-select" required aria-label="Card status"><% (c.status==='frozen'?(canActivate?['active','blocked','lost_stolen']:['blocked','lost_stolen']):['frozen','blocked','lost_stolen']).forEach(s=>{ %><option value="<%= s %>"><%= s.replace('_',' / ') %></option><% }) %></select>
                  <input name="reason" class="form-input" required minlength="8" maxlength="500" placeholder="Reason" aria-label="Reason for card status change" style="max-width:180px;">
                  <button type="submit" class="btn btn-warning btn-sm">Save</button>
                </form>
              <% } else { %><span class="status-badge">No status transition available</span><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layouts/admin-end') -%>
