<%- include('../partials/layouts/admin-start') -%>

<h2 style="margin-bottom:16px;">Manage Loans <span style="font-size:0.85rem;color:var(--text-light);">(latest 200)</span></h2>
<div class="alert alert-info" style="margin-bottom:20px;"><span class="alert-icon">i</span><div class="alert-content"><div class="alert-title">Audited decision flow</div><p class="alert-message" style="margin:0;">Pending applications are reviewed from the approval queue. A disbursement requires verified KYC, an eligible customer account, a loan-product limit check, and a verified funding reference. Repayment history is retained.</p></div></div>

<div class="card">
  <form class="filter-bar" method="GET" action="/admin/loans">
    <div class="filter-group"><label class="filter-label" for="loanSearch">Search</label><input id="loanSearch" name="search" value="<%= filters.search || '' %>" type="text" class="form-input" placeholder="Customer name or ID"></div>
    <div class="filter-group"><span class="filter-label">Type</span>
      <select class="form-select" name="type"><option value="all">All Types</option><% ['Personal Loan','Home Loan','Car Loan','Business Loan','Education Loan','Line of Credit'].forEach(t=>{ %><option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %></option><% }) %></select>
    </div>
    <div class="filter-group"><span class="filter-label">Status</span>
      <select class="form-select" name="status"><option value="all">All</option><% ['pending','disbursed','active','paid','rejected'].forEach(s=>{ %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select>
    </div>
    <button class="btn btn-primary btn-sm">Filter</button>
  </form>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Customer</th><th>Loan Type</th><th style="text-align:right;">Principal</th><th style="text-align:right;">Remaining</th><th>Term</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% loans.forEach(l => { %>
          <tr>
            <td><div style="font-weight:600;font-size:0.9rem;"><%= l.user_name || 'User #' + l.user_id %></div>
              <div style="font-size:0.72rem;color:var(--text-light);">Loan #<%= String(l.id).padStart(6,'0') %></div></td>
            <td><strong style="font-size:0.85rem;"><%= l.loan_type %></strong>
              <div style="font-size:0.72rem;color:var(--text-light);"><%= parseFloat(l.interest_rate).toFixed(2) %>% p.a. • Mo <%= currency(l.monthly_payment||0) %></div></td>
            <td style="text-align:right;font-weight:700;"><%= currency(l.principal_amount) %></td>
            <td style="text-align:right;font-weight:700;color:<%= parseFloat(l.total_amount)>parseFloat(l.amount_paid)?'var(--danger)':'var(--success)' %>;">
              <%= currency(Math.max(0,parseFloat(l.total_amount)-parseFloat(l.amount_paid))) %>
              <div style="font-size:0.7rem;color:var(--text-light);font-weight:500;">
                <%= (parseFloat(l.amount_paid)/parseFloat(l.total_amount)*100).toFixed(0) %>% paid
              </div></td>
            <td><%= l.term_months %> mo</td>
            <td><span class="status-badge status-<%= l.status %>"><%= l.status %></span></td>
            <td><% if (l.status === 'pending') { %><a class="btn btn-primary btn-sm" href="/admin/approvals?section=loans">Review application</a><% } else { %><span class="status-badge">History retained</span><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layouts/admin-end') -%>
