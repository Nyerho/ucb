<%- include('../partials/layouts/admin-start') -%>

<h2 style="margin-bottom:16px;">📊 Reports & Analytics</h2>

<div class="stat-cards" style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px;">
  <div class="stat-card">
    <div class="stat-header">
      <div><div class="stat-label">30-day Revenue</div>
      <div class="stat-value"><%= currency(revenue) %></div></div>
      <div class="stat-icon stat-icon-primary">📈</div>
    </div><div class="stat-change up">+12.4% MoM</div>
  </div>
  <div class="stat-card">
    <div class="stat-header"><div>
      <div class="stat-label">New Signups (30d)</div>
      <div class="stat-value"><%= (monthlyData.reduce((s,m)=>s+m.new_customers,0)).toLocaleString() %></div></div>
      <div class="stat-icon stat-icon-success">👥</div>
    </div><div class="stat-change up">+8.1% vs prior</div>
  </div>
  <div class="stat-card">
    <div class="stat-header"><div>
      <div class="stat-label">Deposits (30d)</div>
      <div class="stat-value"><%= currency(monthlyData.reduce((s,m)=>s+m.deposits,0)) %></div></div>
      <div class="stat-icon stat-icon-success">⬇️</div>
    </div><div class="stat-change up">+15.7% MoM</div>
  </div>
  <div class="stat-card">
    <div class="stat-header"><div>
      <div class="stat-label">Active Loans</div>
      <div class="stat-value" style="color:var(--warning);"><%= currency(loanTotals.total_outstanding) %></div></div>
      <div class="stat-icon stat-icon-warning">🏦</div>
    </div><div class="stat-change"><%= loanTotals.count %> loans</div>
  </div>
</div>

<div class="grid-2" style="margin-bottom:24px;">
  <div class="card">
    <div class="card-header"><h3 class="card-title">📈 Last 12 Months Performance</h3></div>
    <div class="card-body">
      <div class="chart" style="height:240px;display:flex;align-items:end;gap:8px;padding-top:20px;">
        <% monthlyData.forEach(m => {
          const h = 100;
          const max = Math.max(...monthlyData.map(x => x.deposits + x.withdrawals)) || 1;
          const depH = (m.deposits / max) * h;
          const withH = (m.withdrawals / max) * h;
        %>
          <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;">
            <div style="width:100%;display:flex;gap:2px;align-items:end;height:200px;">
              <div style="flex:1;background:var(--success);border-radius:6px 6px 0 0;min-height:4px;height:<%= depH %>px;transition:var(--transition);" title="Dep <%= currency(m.deposits) %>"></div>
              <div style="flex:1;background:var(--danger);border-radius:6px 6px 0 0;min-height:4px;height:<%= withH %>px;transition:var(--transition);" title="With <%= currency(m.withdrawals) %>"></div>
            </div>
            <div style="font-size:0.7rem;color:var(--text-light);font-weight:600;"><%= m.month %></div>
          </div>
        <% }) %>
      </div>
      <div style="display:flex;justify-content:center;gap:20px;margin-top:10px;">
        <div style="display:flex;align-items:center;gap:6px;"><span style="width:10px;height:10px;background:var(--success);border-radius:2px;"></span><span style="font-size:0.82rem;color:var(--text-gray);">Deposits</span></div>
        <div style="display:flex;align-items:center;gap:6px;"><span style="width:10px;height:10px;background:var(--danger);border-radius:2px;"></span><span style="font-size:0.82rem;color:var(--text-gray);">Withdrawals</span></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title">💸 Transaction Type Breakdown (30 days)</h3></div>
    <div class="card-body" style="padding:0;">
      <% typeBreakdown.forEach(t => { 
        const pct = (t.count / Math.max(1, typeBreakdown.reduce((s,x)=>s+x.count,0)) * 100).toFixed(1);
      %>
        <div style="padding:14px 20px;border-bottom:1px solid var(--border);">
          <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
            <div style="font-weight:600;font-size:0.9rem;display:flex;align-items:center;gap:8px;">
              <%= t.type.includes('local')?'🇦🇺':t.type.includes('intl')?'🌍':t.type.includes('dep')?'⬇️':t.type.includes('with')?'⬆️':t.type.includes('bill')?'📄':t.type.includes('loan')?'💳':'💸' %>
              <%= t.type.replace(/_/g,' ').replace(/\b\w/g, l => l.toUpperCase()) %>
            </div>
            <div style="text-align:right;">
              <div style="font-weight:800;"><%= currency(t.total) %></div>
              <div style="font-size:0.72rem;color:var(--text-light);"><%= t.count %> tx</div>
            </div>
          </div>
          <div class="progress"><div class="progress-bar" style="width:<%= pct %>%;"></div></div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3 class="card-title">🏦 Accounts Summary by Type</h3></div>
    <div class="card-body" style="padding:0;">
      <% accountSummary.forEach(a => { %>
        <div style="padding:14px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
          <div><div style="font-weight:700;"><%= a.type %></div>
            <div style="font-size:0.78rem;color:var(--text-light);"><%= a.count %> accounts</div></div>
          <div style="text-align:right;">
            <div style="font-weight:800;color:var(--primary);"><%= currency(a.total_balance) %></div>
            <div style="font-size:0.78rem;color:var(--text-light);">Avg: <%= currency(a.count?a.total_balance/a.count:0) %></div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title">🏦 Loan Summary by Type</h3></div>
    <div class="card-body" style="padding:0;">
      <% loanSummary.forEach(l => { %>
        <div style="padding:14px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
          <div><div style="font-weight:700;"><%= l.type %></div>
            <div style="font-size:0.78rem;color:var(--text-light);"><%= l.count %> active • Avg <%= parseFloat(l.avg_rate).toFixed(2) %>%</div></div>
          <div style="text-align:right;">
            <div style="font-weight:800;color:var(--warning);"><%= currency(l.outstanding) %></div>
            <div style="font-size:0.78rem;color:var(--text-light);">Mo: <%= currency(l.monthly_total) %></div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<%- include('../partials/layouts/admin-end') -%>


