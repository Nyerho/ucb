<%- include('../partials/layouts/admin-start') -%>

<h2 style="margin-bottom:16px;">⚙️ Admin Settings</h2>
<div class="alert alert-warning" style="margin-bottom:20px;"><span class="alert-icon">!</span><div class="alert-content"><div class="alert-title">Role and policy changes are disabled</div>
  <p class="alert-message" style="margin:0;">This page is read-only. Admin creation, role elevation, approval thresholds, and financial policy changes require reviewed Firebase Authentication, dual-control, and audit workflows.</p></div></div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3 class="card-title">👑 Current administrator records (read-only)</h3></div>
    <div class="card-body" style="padding:0;">
      <% admins.forEach(a => { %>
        <div style="padding:16px 24px;border-bottom:1px solid var(--border);display:flex;gap:14px;align-items:center;">
          <div class="user-avatar" style="width:44px;height:44px;font-size:0.95rem;background:linear-gradient(135deg,#111,#374151);color:white;"><%= (a.first_name||'A').charAt(0)+(a.last_name||'').charAt(0) %></div>
          <div style="flex:1;min-width:0;"><div style="font-weight:700;font-size:0.95rem;"><%= a.first_name %> <%= a.last_name %></div><div style="font-size:0.82rem;color:var(--text-light);">📧 <%= a.email %> · 📱 <%= a.phone %></div></div>
          <span class="status-badge status-active"><%= a.role === 'super_admin' ? 'Super Admin' : 'Admin' %></span>
        </div>
      <% }) %>
      <% if (!admins.length) { %><div class="empty-state" style="padding:24px;">No administrator records found.</div><% } %>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3 class="card-title">Session information</h3></div>
    <div class="card-body">
      <p><strong>Logged in as:</strong> <%= user.email %></p>
      <p><strong>Role:</strong> Administrator</p>
      <p style="margin-bottom:0;color:var(--text-gray);">Session lifetime and signing configuration are controlled by the Cloudflare Worker environment, not by this screen.</p>
    </div>
  </div>
</div>

<%- include('../partials/layouts/admin-end') -%>
