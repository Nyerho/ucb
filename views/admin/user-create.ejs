<%- include('../partials/layouts/admin-start') -%>

<a href="/admin/users" class="btn btn-outline btn-sm" style="margin-bottom:16px;">← All customers</a>
<div class="card" style="max-width:820px;">
  <div class="card-header"><h2 class="card-title">Create a customer</h2></div>
  <div class="card-body">
    <div class="alert alert-warning" style="margin-bottom:20px;">
      <span class="alert-icon">!</span><div class="alert-content"><div class="alert-title">Real Firebase identity; no initial funds</div>
      <p class="alert-message" style="margin:0;">This form creates a Firebase Authentication identity and its Firestore customer profile plus one zero-balance Everyday Savings account in an audited transaction. Firebase sends a password-reset email; no temporary password, admin role, KYC approval, or opening deposit is created.</p></div>
    </div>
    <form method="POST" action="/admin/users/create">
      <div class="form-grid">
        <div class="form-group"><label class="form-label" for="first_name">First name</label><input id="first_name" name="first_name" class="form-input" minlength="2" maxlength="80" required autocomplete="given-name"></div>
        <div class="form-group"><label class="form-label" for="last_name">Last name</label><input id="last_name" name="last_name" class="form-input" minlength="2" maxlength="80" required autocomplete="family-name"></div>
      </div>
      <div class="form-grid">
        <div class="form-group"><label class="form-label" for="email">Email</label><input id="email" name="email" class="form-input" type="email" maxlength="254" required autocomplete="email"></div>
        <div class="form-group"><label class="form-label" for="phone">Phone</label><input id="phone" name="phone" class="form-input" type="tel" minlength="6" maxlength="30" required autocomplete="tel"></div>
      </div>
      <div class="form-group"><label class="form-label" for="address">Address</label><input id="address" name="address" class="form-input" maxlength="160" autocomplete="street-address"></div>
      <div class="form-grid">
        <div class="form-group"><label class="form-label" for="city">City</label><input id="city" name="city" class="form-input" maxlength="80" autocomplete="address-level2"></div>
        <div class="form-group"><label class="form-label" for="state">State or territory</label><select id="state" name="state" class="form-select"><option value="">Select</option><% ['NSW','VIC','QLD','SA','WA','TAS','NT','ACT'].forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %></select></div>
        <div class="form-group"><label class="form-label" for="postcode">Postcode</label><input id="postcode" name="postcode" class="form-input" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="postal-code"></div>
      </div>
      <div class="form-group"><label class="form-label" for="reason">Reason / verified onboarding reference</label><input id="reason" name="reason" class="form-input" minlength="8" maxlength="500" required placeholder="At least 8 characters"></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <button type="submit" class="btn btn-primary">Create Firebase customer</button>
        <a href="/admin/users" class="btn btn-light">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/layouts/admin-end') -%>
