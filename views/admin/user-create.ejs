<%- include('../partials/layouts/admin-start') -%>

<a href="/admin/users" class="btn btn-outline btn-sm" style="margin-bottom:16px;">← All Users</a>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3 class="card-title">➕ Create New Customer</h3></div>
    <div class="card-body">
      <form method="POST" action="/admin/users/create">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">First Name *</label>
            <input type="text" name="first_name" required class="form-input" placeholder="John">
          </div>
          <div class="form-group">
            <label class="form-label">Last Name *</label>
            <input type="text" name="last_name" required class="form-input" placeholder="Smith">
          </div>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Email *</label>
            <input type="email" name="email" required class="form-input" placeholder="john@example.com.au">
          </div>
          <div class="form-group">
            <label class="form-label">Phone *</label>
            <input type="tel" name="phone" required class="form-input" placeholder="0400 000 000">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Temporary Password *</label>
          <input type="text" name="password" required minlength="8" class="form-input" value="Welcome@2026">
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Address</label>
            <input type="text" name="address" class="form-input">
          </div>
          <div class="form-group">
            <label class="form-label">City / Suburb</label>
            <input type="text" name="city" class="form-input">
          </div>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">State</label>
            <select name="state" class="form-select">
              <option value="">Select...</option>
              <% ['NSW','VIC','QLD','SA','WA','TAS','NT','ACT'].forEach(s => { %>
                <option><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Postcode</label>
            <input type="text" name="postcode" maxlength="4" class="form-input">
          </div>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Auto-create Account</label>
            <select name="account_type" class="form-select">
              <option value="">-- No account --</option>
              <option value="Everyday Savings Account">Everyday Savings</option>
              <option value="High Interest Account">High Interest 4.25%</option>
              <option value="Business Account">Business</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Initial Deposit (if account)</label>
            <input type="number" name="initial_balance" min="0" step="0.01" value="0" class="form-input">
          </div>
        </div>
        <div style="display:flex;gap:8px;margin-top:8px;align-items:center;flex-wrap:wrap;">
          <input type="checkbox" name="is_verified" id="cv" class="form-checkbox"><label for="cv" style="margin:0;">Auto Verify KYC</label>
          <input type="checkbox" name="is_admin" id="ca" class="form-checkbox"><label for="ca" style="margin:0;"><strong style="color:var(--danger);">Create as Admin</strong></label>
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:20px;">
          <a href="/admin/users" class="btn btn-light btn-lg">Cancel</a>
          <button type="submit" class="btn btn-primary btn-lg">✅ Create User</button>
        </div>
      </form>
    </div>
  </div>

  <div>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header"><h3 class="card-title">⚡ Bulk Actions</h3></div>
      <div class="card-body" style="display:flex;flex-direction:column;gap:8px;">
        <a href="/admin/approvals?tab=kyc" class="btn btn-outline btn-block">🆔 Bulk Approve KYC</a>
        <a href="/admin/approvals?tab=transfers" class="btn btn-outline btn-block">💸 Bulk Approve Transfers</a>
        <a href="/admin/reports" class="btn btn-outline btn-block">📊 Export User Data</a>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">💡 Guidelines</h3></div>
      <div class="card-body" style="padding:0;">
        <div style="padding:14px 20px;border-bottom:1px solid var(--border);">
          <div style="font-weight:700;font-size:0.9rem;">🔐 Strong passwords</div>
          <div style="font-size:0.82rem;color:var(--text-light);">Min 8 chars, include numbers & symbols</div>
        </div>
        <div style="padding:14px 20px;border-bottom:1px solid var(--border);">
          <div style="font-weight:700;font-size:0.9rem;">🆔 Verify KYC first</div>
          <div style="font-size:0.82rem;color:var(--text-light);">Only auto-verify if documents provided</div>
        </div>
        <div style="padding:14px 20px;">
          <div style="font-weight:700;font-size:0.9rem;">📝 Audit trail</div>
          <div style="font-size:0.82rem;color:var(--text-light);">All admin actions are logged and reviewed</div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/layouts/admin-end') -%>

