<%- include('../partials/layouts/admin-start') -%>

<a href="/admin/users" class="btn btn-outline btn-sm" style="margin-bottom:16px;">← All Users</a>
<%
  const frozen = customer.is_frozen === true || Number(customer.is_frozen) === 1;
  const disabled = customer.disabled === true || Number(customer.disabled) === 1;
  const total = Number(totalBalance || 0);
%>
<div class="card" style="margin-bottom:20px;">
  <div class="card-body" style="padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap;">
      <div>
        <h2 style="margin:0;"><%= customer.first_name || '' %> <%= customer.last_name || '' %></h2>
        <div style="margin-top:6px;color:var(--text-gray);">UID <%= customer.id %> · <%= customer.email || 'No email on record' %> · <%= customer.phone || 'No phone on record' %></div>
        <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;">
          <span class="status-badge status-<%= disabled ? 'rejected' : (frozen ? 'frozen' : 'active') %>"><%= disabled ? 'Disabled' : (frozen ? 'Frozen' : 'Active') %></span>
          <span class="status-badge status-<%= customer.is_verified ? 'completed' : 'pending' %>"><%= customer.is_verified ? 'KYC verified' : 'KYC unverified' %></span>
          <% if (customer.is_admin === true || Number(customer.is_admin) === 1 || customer.role === 'admin') { %><span class="status-badge status-rejected">Administrator</span><% } %>
        </div>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <button type="button" class="btn btn-primary" onclick="document.getElementById('editUserModal').classList.add('active')">Edit profile</button>
        <% if (!(customer.is_admin === true || Number(customer.is_admin) === 1 || customer.role === 'admin')) { %>
          <% if (!disabled) { %>
            <form method="POST" action="/admin/users/<%= encodeURIComponent(customer.id) %>/<%= frozen ? 'unfreeze' : 'freeze' %>" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
              <input type="text" name="reason" required minlength="8" maxlength="500" class="form-input" aria-label="Reason for account status change" placeholder="Reason (8–500 chars)" style="width:220px;">
              <button type="submit" class="btn <%= frozen ? 'btn-success' : 'btn-warning' %>"><%= frozen ? 'Unfreeze customer' : 'Freeze customer' %></button>
            </form>
          <% } %>
          <form method="POST" action="/admin/users/<%= encodeURIComponent(customer.id) %>/<%= disabled ? 'restore' : 'disable' %>" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <input type="text" name="reason" required minlength="8" maxlength="500" class="form-input" aria-label="Reason for customer access change" placeholder="Reason (8–500 chars)" style="width:220px;">
            <button type="submit" class="btn <%= disabled ? 'btn-success' : 'btn-danger' %>"><%= disabled ? 'Restore customer' : 'Disable access' %></button>
          </form>
          <% if (!disabled) { %>
            <form method="POST" action="/admin/users/<%= encodeURIComponent(customer.id) %>/password-reset" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
              <input type="text" name="reason" required minlength="8" maxlength="500" class="form-input" aria-label="Reason for password-reset email" placeholder="Reason (8–500 chars)" style="width:220px;">
              <button type="submit" class="btn btn-outline">Send reset email</button>
            </form>
          <% } %>
        <% } %>
      </div>
    </div>
    <div class="stat-cards" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:22px;padding-top:20px;border-top:1px solid var(--border);">
      <div class="mini-stat"><div class="mini-stat-label">Aggregate balance</div><div class="mini-stat-value"><%= currency(total) %></div></div>
      <div class="mini-stat"><div class="mini-stat-label">Accounts</div><div class="mini-stat-value"><%= (accounts || []).length %></div></div>
      <div class="mini-stat"><div class="mini-stat-label">Cards</div><div class="mini-stat-value"><%= (cards || []).length %></div></div>
      <div class="mini-stat"><div class="mini-stat-label">Loans</div><div class="mini-stat-value"><%= (loans || []).length %></div></div>
    </div>
  </div>
</div>

<div class="alert alert-info" style="margin-bottom:20px;">
  <span class="alert-icon">i</span><div class="alert-content"><div class="alert-title">Audited controls; financial history is retained</div>
  <p class="alert-message" style="margin:0;">Access and profile changes are audited. Account openings start at zero. Balance corrections must use the separate reasoned adjustment form and create a transaction plus ledger entry; transaction history, Firebase identities, and submitted documents are never hard-deleted here.</p></div>
</div>

<div class="card" style="margin-bottom:20px;">
  <div class="card-header"><h3 class="card-title">Accounts</h3></div>
  <% if (!disabled) { %>
    <div class="card-body" style="border-bottom:1px solid var(--border);">
      <form method="POST" action="/admin/users/<%= encodeURIComponent(customer.id) %>/accounts" class="form-grid">
        <input type="hidden" name="operation_id" value="<%= operationId %>">
        <div class="form-group"><label class="form-label">Account type</label><select name="account_type" class="form-select" required><% ['Everyday Savings','Everyday Savings Account','High Interest Account','Term Deposit Account','Business Account','Multi-Currency Account'].forEach(t => { %><option value="<%= t %>"><%= t %></option><% }) %></select></div>
        <div class="form-group"><label class="form-label">Branch (optional)</label><input name="branch" class="form-input" maxlength="80"></div>
        <div class="form-group"><label class="form-label">BSB (optional)</label><input name="bsb" class="form-input" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"></div>
        <div class="form-group"><label class="form-label">Reason / opening reference</label><input name="reason" class="form-input" minlength="8" maxlength="500" required></div>
        <div class="form-group" style="align-self:end;"><button type="submit" class="btn btn-primary">Open zero-balance account</button></div>
      </form>
      <p class="form-hint" style="margin-bottom:0;">No initial balance is permitted. Any opening deposit must be recorded as a separate approved settlement.</p>
    </div>
  <% } %>
  <div class="table-wrap"><table class="table"><thead><tr><th>Account</th><th>Number</th><th>Balance</th><th>Status</th><th>Control</th></tr></thead><tbody>
    <% (accounts || []).forEach(a => { const accountStatus = String(a.status || 'active').toLowerCase(); const canChange = ['active','frozen','blocked'].includes(accountStatus); %>
      <tr>
        <td><a href="/admin/accounts/<%= encodeURIComponent(a.id) %>"><strong><%= a.account_name || a.account_type || 'Account' %></strong></a><div style="font-size:0.75rem;color:var(--text-light);"><%= a.account_type || '' %></div></td>
        <td style="font-family:monospace;"><%= a.account_number || '—' %></td>
        <td><%= currency(a.balance || 0) %></td>
        <td><span class="status-badge status-<%= accountStatus %>"><%= accountStatus %></span></td>
        <td>
          <% if (canChange) { %>
            <form method="POST" action="/admin/accounts/<%= encodeURIComponent(a.id) %>/status" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
              <select name="status" required class="form-select" aria-label="Account status">
                <% ['active','frozen','blocked','closed'].forEach(s => { %><option value="<%= s %>" <%= s === accountStatus ? 'selected' : '' %>><%= s %></option><% }) %>
              </select>
              <input type="text" name="reason" required minlength="8" maxlength="500" class="form-input" aria-label="Reason for account status change" placeholder="Reason" style="width:170px;">
              <button type="submit" class="btn btn-light btn-sm">Save status</button>
            </form>
          <% } else { %><span style="color:var(--text-light);">Closed or legacy state; review required</span><% } %>
        </td>
      </tr>
    <% }) %>
  </tbody></table></div>
</div>

<div class="grid-2" style="margin-bottom:20px;">
  <div class="card"><div class="card-header"><h3 class="card-title">Recent transactions (read-only)</h3></div>
    <div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Type / Description</th><th>Amount</th><th>Status</th></tr></thead><tbody>
      <% (transactions || []).slice(0, 20).forEach(tx => { %><tr>
        <td><%= moment(tx.created_at).format('DD MMM YYYY HH:mm') %></td>
        <td><a href="/admin/transactions/<%= encodeURIComponent(tx.id) %>"><%= (tx.transaction_type || 'transaction').replace(/_/g,' ') %></a><div style="font-size:0.75rem;color:var(--text-light);"><%= tx.description || tx.recipient_name || '' %></div></td>
        <td><%= currency(tx.amount || 0) %></td><td><span class="status-badge status-<%= tx.status %>"><%= tx.status %></span></td>
      </tr><% }) %>
      <% if (!(transactions || []).length) { %><tr><td colspan="4">No transaction records.</td></tr><% } %>
    </tbody></table></div>
  </div>
  <div class="card"><div class="card-header"><h3 class="card-title">Cards</h3></div>
    <div class="card-body" style="padding:0;">
      <% (cards || []).forEach(c => { const canManageCard = ['approved','awaiting_issuer','active','frozen'].includes(String(c.status)); const canActivateCard = c.fulfillment_status === 'issued'; %><div style="padding:13px 20px;border-bottom:1px solid var(--border);"><strong><%= c.card_type || 'Card' %></strong> · •••• <%= c.card_last4 || String(c.card_number || '').slice(-4) || '—' %><div style="font-size:0.78rem;color:var(--text-light);">Status: <%= c.status || 'unknown' %> · Approved cards still require manual issuer fulfillment.</div>
        <% if (canManageCard) { %><form method="POST" action="/admin/cards/<%= encodeURIComponent(c.id) %>/status" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:8px;"><select name="status" class="form-select" required aria-label="Card status"><% (c.status==='frozen'?(canActivateCard?['active','blocked','lost_stolen']:['blocked','lost_stolen']):['frozen','blocked','lost_stolen']).forEach(s=>{ %><option value="<%= s %>"><%= s.replace('_',' / ') %></option><% }) %></select><input name="reason" class="form-input" required minlength="8" maxlength="500" placeholder="Reason" aria-label="Reason for card status change"><button type="submit" class="btn btn-warning btn-sm">Save audited status</button></form><% } %>
      </div><% }) %>
      <% if (!(cards || []).length) { %><div class="empty-state" style="padding:24px;">No card records.</div><% } %>
    </div>
  </div>
</div>

<div class="grid-2" style="margin-bottom:20px;">
  <div class="card"><div class="card-header"><h3 class="card-title">Loans (read-only)</h3></div>
    <div class="card-body" style="padding:0;">
      <% (loans || []).forEach(l => { %><div style="padding:13px 20px;border-bottom:1px solid var(--border);"><strong><%= l.loan_type || 'Loan' %></strong> · <%= currency(l.loan_amount || l.principal_amount || 0) %><div style="font-size:0.78rem;color:var(--text-light);">Status: <%= l.status || 'unknown' %> · <%= l.status === 'pending' ? 'Decision in the approval queue' : 'Loan history retained' %> <% if (l.status === 'pending') { %>· <a href="/admin/approvals?section=loans">Review</a><% } %></div></div><% }) %>
      <% if (!(loans || []).length) { %><div class="empty-state" style="padding:24px;">No loan records.</div><% } %>
    </div>
  </div>
  <div class="card"><div class="card-header"><h3 class="card-title">KYC records (read-only)</h3></div>
    <div class="card-body" style="padding:0;">
      <% (kyc || []).forEach(k => { %><div style="padding:13px 20px;border-bottom:1px solid var(--border);"><strong><%= k.document_type || 'Identity document' %></strong><div style="font-size:0.78rem;color:var(--text-light);">Status: <%= k.status || 'unknown' %> · Submitted <%= moment(k.submitted_at || k.created_at).format('DD MMM YYYY') %> · <% if (k.status === 'pending') { %><a href="/admin/approvals?section=kyc">Review</a><% } %></div><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:6px;"><% if (k.has_document_front) { %><a href="/kyc/<%= encodeURIComponent(k.id) %>/document/front" target="_blank" rel="noopener">Download front document</a><% } %><% if (k.has_document_back) { %><a href="/kyc/<%= encodeURIComponent(k.id) %>/document/back" target="_blank" rel="noopener">Download back document</a><% } %><% if (k.has_document_selfie) { %><a href="/kyc/<%= encodeURIComponent(k.id) %>/document/selfie" target="_blank" rel="noopener">Download selfie</a><% } %></div></div><% }) %>
      <% if (!(kyc || []).length) { %><div class="empty-state" style="padding:24px;">No KYC records.</div><% } %>
    </div>
  </div>
</div>

<div class="card" style="margin-bottom:20px;"><div class="card-header"><h3 class="card-title">Admin audit history</h3></div>
  <div class="card-body" style="padding:0;">
    <% (auditLogs || []).forEach(log => { %><div style="padding:13px 20px;border-bottom:1px solid var(--border);">
      <strong><%= String(log.action || 'admin action').replace(/_/g,' ') %></strong> · <%= log.target_type || 'record' %> #<%= log.target_id || '' %>
      <div style="font-size:0.78rem;color:var(--text-light);"><%= log.details || '' %></div>
      <div style="font-size:0.75rem;color:var(--text-light);"><%= moment(log.created_at).format('DD MMM YYYY HH:mm') %> · Admin <%= log.admin_id || '—' %></div>
    </div><% }) %>
    <% if (!(auditLogs || []).length) { %><div class="empty-state" style="padding:24px;">No audit records.</div><% } %>
  </div>
</div>

<div class="modal" id="editUserModal"><div class="modal-dialog" style="max-width:640px;">
  <div class="modal-header"><h3 class="modal-title">Edit customer profile</h3>
    <button type="button" class="modal-close" onclick="document.getElementById('editUserModal').classList.remove('active')">×</button></div>
  <form method="POST" action="/admin/users/<%= encodeURIComponent(customer.id) %>/update">
    <div class="modal-body">
      <div class="form-grid">
        <div class="form-group"><label class="form-label">First name</label><input type="text" name="first_name" required minlength="2" maxlength="80" value="<%= customer.first_name || '' %>" class="form-input"></div>
        <div class="form-group"><label class="form-label">Last name</label><input type="text" name="last_name" required minlength="2" maxlength="80" value="<%= customer.last_name || '' %>" class="form-input"></div>
      </div>
      <div class="form-group"><label class="form-label">Phone</label><input type="tel" name="phone" required minlength="6" maxlength="30" value="<%= customer.phone || '' %>" class="form-input"></div>
      <div class="form-group"><label class="form-label">Address</label><input type="text" name="address" maxlength="160" value="<%= customer.address || '' %>" class="form-input"></div>
      <div class="form-grid">
        <div class="form-group"><label class="form-label">City</label><input type="text" name="city" maxlength="80" value="<%= customer.city || '' %>" class="form-input"></div>
        <div class="form-group"><label class="form-label">State / territory</label>
          <select name="state" class="form-select"><option value=""></option>
            <% ['NSW','VIC','QLD','SA','WA','TAS','NT','ACT'].forEach(s => { %><option value="<%= s %>" <%= customer.state === s ? 'selected' : '' %>><%= s %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="form-group"><label class="form-label">Postcode</label><input type="text" name="postcode" maxlength="4" pattern="[0-9]{4}" value="<%= customer.postcode || '' %>" class="form-input"></div>
      <div class="form-group"><label class="form-label">Reason for correction</label><input type="text" name="reason" required minlength="8" maxlength="500" class="form-input" placeholder="Customer request or verified correction reference"></div>
      <p class="form-hint">Email, identity verification, account ownership, password, and administrator role cannot be changed here.</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-light" onclick="document.getElementById('editUserModal').classList.remove('active')">Cancel</button>
      <button type="submit" class="btn btn-primary">Save audited profile</button>
    </div>
  </form>
</div></div>

<style>
.mini-stat{padding:14px;background:var(--bg-gray);border-radius:var(--radius);}
.mini-stat-label{font-size:0.72rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;}
.mini-stat-value{font-weight:800;font-size:1.25rem;margin-top:4px;}
</style>

<%- include('../partials/layouts/admin-end') -%>
