<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#C8102E">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23C8102E'/><text x='50' y='62' font-size='48' font-family='Arial' font-weight='800' text-anchor='middle' fill='white'>U</text></svg>">
</head>
<body class="auth-wrap">
  <div class="auth-card" style="max-width:480px;">
    <div style="text-align:center;margin-bottom:32px;">
      <div class="brand-logo" style="width:64px;height:64px;border-radius:16px;margin:0 auto 16px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">UCB</div>
      <h1 style="font-size:1.5rem;margin-bottom:8px;">Reset your password</h1>
      <p style="color:var(--text-gray);margin:0;">Enter your email and we'll send you reset instructions.</p>
    </div>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="form-alert form-alert-success">✓ <%= success %></div>
    <% } %>
    <form action="/auth/forgot-password" method="POST">
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input type="email" name="email" class="form-input" placeholder="you@example.com" required>
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-block">📧 Send Reset Link</button>
    </form>
    <div class="auth-footer">
      Remembered it? <a href="/auth/login" style="font-weight:600;">Return to Login</a>
    </div>
  </div>
  <script src="/js/common.js"></script>
</body>
</html>
