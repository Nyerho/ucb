<% const pageScripts = ['/js/bills.js']; %>
<%- include('../partials/layouts/user-start') -%>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
  <div>
    <h2 style="margin:0;">📄 Bills & Payments</h2>
    <p style="margin:4px 0 0;color:var(--text-gray);">BPAY®, scheduled payments, deposits & withdrawals.</p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <a href="/billpay/pay" class="btn btn-primary">➕ Pay Bill</a>
    <a href="/billpay/deposit/new" class="btn btn-success">⬇️ Deposit</a>
    <a href="/billpay/withdraw/new" class="btn btn-warning">⬆️ Withdraw</a>
  </div>
</div>

<div class="quick-actions">
  <a href="/billpay/pay" class="quick-action"><div class="quick-action-icon">📄</div><span class="quick-action-label">Pay Bill (BPAY)</span></a>
  <a href="/billpay/scheduled" class="quick-action"><div class="quick-action-icon">📅</div><span class="quick-action-label">Scheduled</span></a>
  <a href="/billpay/deposit/new" class="quick-action"><div class="quick-action-icon">⬇️</div><span class="quick-action-label">Deposit</span></a>
  <a href="/billpay/withdraw/new" class="quick-action"><div class="quick-action-icon">⬆️</div><span class="quick-action-label">Withdraw</span></a>
</div>

<div class="grid-2-1">
  <div>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header">
        <h3 class="card-title">⏰ Upcoming / Pending</h3>
        <a href="/billpay/scheduled" class="btn btn-outline btn-sm">Manage</a>
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Due</th><th>Biller</th><th>Ref</th><th style="text-align:right;">Amount</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% const pending = upcoming.filter(b => b.status === 'pending' || b.status === 'scheduled'); %>
            <% if (pending.length === 0) { %>
              <tr><td colspan="5"><div class="empty-state" style="padding:32px 20px;"><div class="empty-state-icon" style="width:48px;height:48px;font-size:1.3rem;">✅</div><h4>No upcoming bills</h4></div></td></tr>
            <% } %>
            <% pending.forEach(b => { %>
              <tr style="cursor:pointer;" onclick="location.href='/billpay/<%= b.id %>'">
                <td><%= b.due_date ? moment(b.due_date).format('DD MMM') : moment(b.created_at).format('DD MMM') %></td>
                <td>
                  <div style="font-weight:600;font-size:0.9rem;"><%= b.biller_name || b.description || 'Payment' %></div>
                  <% if (b.biller_code) { %><div style="font-size:0.75rem;color:var(--text-light);">BPAY Code: <%= b.biller_code %></div><% } %>
                </td>
                <td style="font-family:monospace;font-size:0.82rem;color:var(--text-gray);"><%= b.customer_ref || '—' %></td>
                <td style="text-align:right;font-weight:700;color:var(--danger);">-<%= currency(b.amount) %></td>
                <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">✅ Recently Completed</h3>
        <span style="font-size:0.85rem;color:var(--text-light);"><%= completed.length %> bill(s)</span>
      </div>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Paid</th><th>Biller</th><th>Ref</th><th style="text-align:right;">Amount</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% if (completed.length === 0) { %>
              <tr><td colspan="5"><div class="empty-state" style="padding:32px 20px;"><div class="empty-state-icon" style="width:48px;height:48px;font-size:1.3rem;">📋</div><h4>No completed bill payments yet</h4></div></td></tr>
            <% } %>
            <% completed.forEach(b => { %>
              <tr style="cursor:pointer;" onclick="location.href='/billpay/<%= b.id %>'">
                <td><%= moment(b.paid_at || b.completed_at || b.created_at).format('DD MMM YYYY') %></td>
                <td>
                  <div style="font-weight:600;font-size:0.9rem;"><%= b.biller_name || b.description || 'Bill Payment' %></div>
                  <% if (b.biller_code) { %><div style="font-size:0.75rem;color:var(--text-light);">BPAY: <%= b.biller_code %></div><% } %>
                </td>
                <td style="font-family:monospace;font-size:0.82rem;color:var(--text-gray);"><%= b.customer_ref || '—' %></td>
                <td style="text-align:right;font-weight:700;color:var(--danger);">-<%= currency(b.amount) %></td>
                <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header"><h3 class="card-title">🏢 Popular Billers</h3></div>
      <div class="card-body" style="padding:0;">
        <% billers.slice(0, 8).forEach(biller => { %>
          <div style="padding:12px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;cursor:pointer;"
               onclick="location.href='/billpay/pay?biller=<%= encodeURIComponent(biller.name) %>&code=<%= biller.code %>'">
            <div style="width:36px;height:36px;border-radius:10px;background:var(--primary-alpha);color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.8rem;">
              <%= biller.name.charAt(0) %>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:600;font-size:0.88rem;"><%= biller.name %></div>
              <div style="font-size:0.72rem;color:var(--text-light);">BPAY <%= biller.code %></div>
            </div>
            <div style="color:var(--primary);font-weight:700;">→</div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">💡 BPAY Info</h3></div>
      <div class="card-body" style="padding:0;">
        <div style="padding:14px 20px;border-bottom:1px solid var(--border);">
          <div style="font-weight:700;font-size:0.9rem;">⚡ 24/7 via BPAY</div>
          <div style="font-size:0.82rem;color:var(--text-light);">Pay any of 45,000+ Australian billers</div>
        </div>
        <div style="padding:14px 20px;border-bottom:1px solid var(--border);">
          <div style="font-weight:700;font-size:0.9rem;">⏰ Scheduled payments</div>
          <div style="font-size:0.82rem;color:var(--text-light);">Never miss a bill — auto schedule recurring</div>
        </div>
        <div style="padding:14px 20px;">
          <div style="font-weight:700;font-size:0.9rem;">🔒 No fees</div>
          <div style="font-size:0.82rem;color:var(--text-light);">$0 fee for all BPAY payments</div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/layouts/user-end', { pageScripts }) -%>


