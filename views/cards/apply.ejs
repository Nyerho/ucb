<% const pageScripts = ['/js/cards.js']; %>
<%- include('../partials/layouts/user-start') -%>

<a href="/cards" class="btn btn-outline btn-sm" style="margin-bottom:16px;">← All Cards</a>

<div class="section-header" style="text-align:left;margin-bottom:24px;">
  <span class="section-eyebrow">💳 Apply for Card</span>
  <h2 style="font-size:2rem;margin:12px 0 8px;">Get your new card today</h2>
  <p style="margin:0;">Applications typically approved within 1 business day for verified customers.</p>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3 class="card-title">📝 Application Form</h3></div>
    <div class="card-body">
      <form method="POST" action="/cards/apply">
        <div class="form-group">
          <label class="form-label">Select Card Type *</label>
          <select name="card_type" required class="form-select" id="cardTypeSelect" onchange="updateCardSummary()">
            <% cardTypes.forEach((c, i) => { %>
              <option value="<%= c.type %>" data-fee="<%= c.fee_raw || 0 %>" data-limit="<%= c.limit_raw || 5000 %>" <%= (typeof selectedCardType !== 'undefined' && selectedCardType === c.type) ? 'selected' : '' %>>
                <%= c.name %> • <%= c.type.includes('Credit') ? c.interest : c.fee %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Title</label>
            <select name="title" class="form-select">
              <option>Mr</option><option>Mrs</option><option>Ms</option>
              <option>Dr</option><option>Prof</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Preferred Name on Card *</label>
            <input type="text" name="cardholder_name" required class="form-input" maxlength="22" placeholder="e.g. JOHN SMITH" value="<%= user.first_name.toUpperCase() %> <%= user.last_name.toUpperCase() %>">
            <span class="form-hint">Max 22 characters, uppercase</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Link to Account (for Debit) *</label>
          <select name="account_id" required class="form-select">
            <% accounts.forEach(acc => { %>
              <option value="<%= acc.id %>"><%= acc.account_type %> • BSB <%= acc.bsb %> • <%= currency(acc.balance) %></option>
            <% }) %>
          </select>
        </div>

        <% if (!user.is_verified) { %>
          <div class="alert alert-warning" style="margin-bottom:20px;">
            <span class="alert-icon">⚠️</span>
            <div class="alert-content">
              <div class="alert-title">KYC Verification Required</div>
              <p class="alert-message" style="margin:0;">Your card application will require KYC verification before approval.
                <a href="/kyc/submit" style="color:var(--primary);font-weight:700;">Complete KYC now →</a>
              </p>
            </div>
          </div>
        <% } %>

        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Employment Status</label>
            <select name="employment" class="form-select">
              <option value="employed">Full-time Employed</option>
              <option value="part_time">Part-time</option>
              <option value="casual">Casual</option>
              <option value="self_employed">Self-Employed</option>
              <option value="retired">Retired</option>
              <option value="student">Student</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Annual Income (AUD)</label>
            <input type="number" name="income" min="0" class="form-input" placeholder="e.g. 75000">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Requested Credit Limit (Credit cards only)</label>
          <select name="credit_limit" class="form-select">
            <option value="">— Use default —</option>
            <option value="2000">$2,000</option>
            <option value="5000">$5,000</option>
            <option value="10000">$10,000</option>
            <option value="15000">$15,000</option>
            <option value="25000">$25,000</option>
            <option value="50000">$50,000</option>
          </select>
        </div>

        <div class="alert alert-info" style="margin-bottom:20px;">
          <span class="alert-icon">ℹ️</span>
          <div class="alert-content">
            <div class="alert-title">Card Delivery</div>
            <p class="alert-message" style="margin:0;">Digital card available instantly in app. Physical card mailed to your address within 3-5 business days (metro Australia).</p>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">✅ Submit Application</button>
      </form>
    </div>
  </div>

  <div>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header"><h3 class="card-title">💳 Preview Card</h3></div>
      <div class="card-body">
        <div id="cardPreview" style="position:relative;border-radius:20px;padding:24px;color:white;background:linear-gradient(135deg,#C8102E,#7A0A1D);overflow:hidden;min-height:210px;">
          <div style="position:absolute;top:-40px;right:-40px;width:180px;height:180px;background:white;opacity:0.06;border-radius:50%;"></div>
          <div style="position:relative;z-index:1;display:flex;justify-content:space-between;align-items:start;">
            <div>
              <div style="font-size:0.7rem;opacity:0.75;text-transform:uppercase;letter-spacing:0.1em;">United Credit Bank</div>
              <div style="font-weight:700;font-size:1.05rem;margin-top:4px;" id="previewCardType"><%= cardTypes[0].name %></div>
            </div>
            <div style="font-size:0.7rem;background:rgba(255,255,255,0.15);padding:4px 10px;border-radius:999px;font-weight:700;">
              <%= user.is_verified ? '● INSTANT APPROVAL' : '⏳ REVIEW' %>
            </div>
          </div>
          <div style="position:relative;z-index:1;margin-top:24px;">
            <div style="display:flex;gap:10px;align-items:center;">
              <div style="width:36px;height:28px;background:linear-gradient(135deg,#FCD34D,#F59E0B);border-radius:4px;"></div>
              <div style="margin-left:auto;font-weight:800;font-style:italic;opacity:0.9;">VISA</div>
            </div>
            <div style="font-family:monospace;font-size:1.15rem;margin-top:16px;letter-spacing:0.05em;font-weight:600;">4539 •••• •••• ####</div>
          </div>
          <div style="position:relative;z-index:1;margin-top:18px;display:flex;justify-content:space-between;align-items:end;">
            <div>
              <div style="font-size:0.6rem;opacity:0.7;text-transform:uppercase;letter-spacing:0.05em;">Cardholder</div>
              <div style="font-weight:600;font-size:0.95rem;"><%= user.first_name.toUpperCase() %> <%= user.last_name.toUpperCase() %></div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:0.6rem;opacity:0.7;text-transform:uppercase;letter-spacing:0.05em;">Exp</div>
              <div style="font-family:monospace;font-weight:600;"><%= moment().add(4, 'years').format('MM/YY') %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">📋 Application Summary</h3></div>
      <div class="card-body" id="applySummaryBox" style="padding:0;">
        <div style="display:flex;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border);">
          <span style="color:var(--text-gray);">Annual fee</span>
          <strong id="sumFee"><%= cardTypes[0].fee %></strong>
        </div>
        <div style="display:flex;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border);">
          <span style="color:var(--text-gray);">Default limit</span>
          <strong id="sumLimit"><%= cardTypes[0].limit %></strong>
        </div>
        <div style="display:flex;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border);">
          <span style="color:var(--text-gray);">Digital card</span>
          <strong style="color:var(--success);">✓ Instant</strong>
        </div>
        <div style="display:flex;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border);">
          <span style="color:var(--text-gray);">Physical card</span>
          <strong>3-5 business days</strong>
        </div>
        <div style="display:flex;justify-content:space-between;padding:14px 20px;">
          <span style="color:var(--text-gray);">Est. decision</span>
          <strong style="color:<%= user.is_verified ? 'var(--success)' : 'var(--warning)' %>;"><%= user.is_verified ? 'Same day' : 'After KYC' %></strong>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function updateCardSummary() {
  const sel = document.getElementById('cardTypeSelect');
  const opts = sel.selectedOptions[0];
  document.getElementById('previewCardType').textContent = sel.textContent.split(' • ')[0];
}
</script>

<%- include('../partials/layouts/user-end', { pageScripts }) -%>


