<%- include('../partials/layouts/user-start') -%>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
  <div>
    <h2 style="margin:0;">💳 My Cards</h2>
    <p style="margin:4px 0 0;color:var(--text-gray);">Debit and credit cards, application status, and controls.</p>
  </div>
  <a href="/cards/apply/new" class="btn btn-primary btn-lg">➕ Apply for Card</a>
</div>

<% if (cards.length > 0) { %>
<div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(320px, 1fr));gap:20px;margin-bottom:28px;">
  <% cards.forEach(card => { 
    const num = card.card_number || '4539000000000000';
    const masked = num.slice(0,4) + ' ' + '•••• ' + '•••• ' + num.slice(-4);
    const isCredit = card.card_type.includes('Credit');
  %>
    <div class="card-item" style="position:relative;border-radius:20px;padding:24px;color:white;background:<%= card.status === 'blocked' || card.is_lost ? 'linear-gradient(135deg,#4B5563,#1F2937)' : isCredit ? 'linear-gradient(135deg,#C8102E,#7A0A1D)' : 'linear-gradient(135deg,#111827,#374151)' %>;overflow:hidden;">
      <div style="position:absolute;top:-40px;right:-40px;width:180px;height:180px;background:white;opacity:0.06;border-radius:50%;"></div>
      <div style="position:absolute;bottom:-30px;left:-30px;width:140px;height:140px;background:white;opacity:0.05;border-radius:50%;"></div>
      <div style="position:relative;display:flex;justify-content:space-between;align-items:start;z-index:1;">
        <div>
          <div style="font-size:0.7rem;opacity:0.75;text-transform:uppercase;letter-spacing:0.1em;">United Credit Bank</div>
          <div style="font-weight:700;font-size:1.1rem;margin-top:4px;"><%= card.card_type %></div>
        </div>
        <% if (card.status === 'blocked' || card.is_lost) { %>
          <span style="font-size:0.65rem;background:rgba(255,255,255,0.2);padding:4px 10px;border-radius:999px;font-weight:700;">BLOCKED</span>
        <% } else if (card.status === 'pending') { %>
          <span style="font-size:0.65rem;background:rgba(255,255,255,0.2);padding:4px 10px;border-radius:999px;font-weight:700;">⏳ PENDING</span>
        <% } else if (card.status === 'active') { %>
          <span style="font-size:0.65rem;background:rgba(34,197,94,0.25);padding:4px 10px;border-radius:999px;font-weight:700;">● ACTIVE</span>
        <% } %>
      </div>
      <div style="position:relative;z-index:1;margin-top:28px;">
        <div style="display:flex;gap:10px;align-items:center;">
          <div style="width:38px;height:30px;background:linear-gradient(135deg,#FCD34D,#F59E0B);border-radius:4px;"></div>
          <% if (isCredit) { %>
            <div style="margin-left:auto;font-size:0.9rem;font-weight:800;font-style:italic;opacity:0.9;">VISA</div>
          <% } else { %>
            <div style="margin-left:auto;font-size:0.85rem;font-weight:800;opacity:0.9;">eftpos ▸</div>
          <% } %>
        </div>
        <div style="font-family:monospace;font-size:1.25rem;margin-top:18px;letter-spacing:0.06em;font-weight:600;"><%= masked %></div>
      </div>
      <div style="position:relative;z-index:1;margin-top:20px;display:flex;justify-content:space-between;align-items:end;">
        <div>
          <div style="font-size:0.6rem;opacity:0.7;text-transform:uppercase;letter-spacing:0.05em;">Cardholder</div>
          <div style="font-weight:600;font-size:0.95rem;"><%= card.cardholder_name || user.first_name + ' ' + user.last_name %></div>
        </div>
        <div style="text-align:right;">
          <div style="font-size:0.6rem;opacity:0.7;text-transform:uppercase;letter-spacing:0.05em;">Exp</div>
          <div style="font-family:monospace;font-weight:600;"><%= card.expiry_date || 'MM/YY' %></div>
        </div>
      </div>
      <div style="position:relative;z-index:1;margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.15);display:flex;gap:8px;flex-wrap:wrap;">
        <a href="/cards/<%= card.id %>" class="btn btn-light btn-sm" style="background:rgba(255,255,255,0.1);color:white;border:1px solid rgba(255,255,255,0.25);">Manage</a>
        <% if (card.status === 'active') { %>
          <a href="/cards/<%= card.id %>/freeze" class="btn btn-light btn-sm" style="background:rgba(255,255,255,0.1);color:white;border:1px solid rgba(255,255,255,0.25);">❄️ Freeze</a>
        <% } else if (card.status === 'frozen') { %>
          <a href="/cards/<%= card.id %>/unfreeze" class="btn btn-light btn-sm" style="background:rgba(255,255,255,0.1);color:white;border:1px solid rgba(255,255,255,0.25);">🔥 Unfreeze</a>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>
<% } else { %>
<div class="card" style="margin-bottom:28px;">
  <div class="card-body">
    <div class="empty-state">
      <div class="empty-state-icon">💳</div>
      <h4>No cards yet</h4>
      <p>Apply for your first United Credit Bank card today — we have options for every lifestyle.</p>
      <a href="/cards/apply/new" class="btn btn-primary btn-lg" style="margin-top:16px;">🚀 Apply Now</a>
    </div>
  </div>
</div>
<% } %>

<div class="section-header" style="text-align:left;">
  <span class="section-eyebrow">💼 Card Products</span>
  <h2 style="font-size:1.6rem;margin:12px 0 4px;">Available cards to apply</h2>
  <p style="margin:0;">All cards work with Apple Pay, Google Pay, and instant digital card issuance.</p>
</div>

<div class="features-grid" style="margin-top:20px;">
  <% cardTypes.forEach(c => { %>
    <div class="feature-card">
      <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:16px;">
        <div class="feature-icon" style="width:52px;height:52px;font-size:1.5rem;border-radius:14px;
          background:<%= c.type.includes('Credit') ? 'linear-gradient(135deg,#C8102E,#7A0A1D)' : c.type.includes('Platinum') ? 'linear-gradient(135deg,#6366F1,#4338CA)' : c.type.includes('Gold') ? 'linear-gradient(135deg,#F59E0B,#B45309)' : 'linear-gradient(135deg,#111827,#374151)' %>;">
          💳
        </div>
        <span class="tag" style="<%= c.type.includes('Platinum') ? 'background:var(--primary-alpha);color:var(--primary);' : '' %>">
          <%= c.type.includes('Credit') ? 'Credit' : 'Debit' %>
        </span>
      </div>
      <h4 class="feature-title"><%= c.name %></h4>
      <p class="feature-desc" style="margin-bottom:16px;"><%= c.desc %></p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:18px;">
        <div>
          <div style="font-size:0.72rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">
            <%= c.type.includes('Credit') ? 'Interest Rate' : 'Annual Fee' %>
          </div>
          <div style="font-weight:700;"><%= c.type.includes('Credit') ? c.interest : c.fee %></div>
        </div>
        <div>
          <div style="font-size:0.72rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">Limit</div>
          <div style="font-weight:700;"><%= c.limit %></div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:18px;">
        <% (c.features || []).forEach(f => { %>
          <div style="font-size:0.85rem;color:var(--text-gray);display:flex;gap:8px;align-items:center;">✓ <%= f %></div>
        <% }) %>
      </div>
      <a href="/cards/apply/new?type=<%= encodeURIComponent(c.type) %>" class="btn btn-primary btn-block btn-sm">Apply Now</a>
    </div>
  <% }) %>
</div>

<%- include('../partials/layouts/user-end') -%>

