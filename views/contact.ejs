<%- include('partials/layouts/main-start') -%>

<section class="hero" style="padding:60px 0 40px;">
  <div class="container">
    <div style="max-width:800px;margin:0 auto;text-align:center;">
      <span class="section-eyebrow">📞 Contact Us</span>
      <h1 style="font-size:3rem;margin:16px 0;">We're here to help.</h1>
      <p class="hero-subtitle" style="margin:0 auto 24px;">Real Australians, based in Sydney, Melbourne, and Brisbane — ready to assist you 7 days a week.</p>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="grid-3">
      <div class="card">
        <div class="card-body" style="text-align:center;padding:32px;">
          <div style="width:64px;height:64px;margin:0 auto 16px;border-radius:var(--radius-lg);background:var(--primary-alpha);display:flex;align-items:center;justify-content:center;font-size:2rem;">📞</div>
          <h3 style="margin-bottom:8px;">Phone Support</h3>
          <div style="font-size:1.5rem;font-weight:800;color:var(--primary);margin-bottom:4px;">1300 UCBANK</div>
          <div style="font-size:0.9rem;color:var(--text-gray);margin-bottom:12px;">(1300 822 265)</div>
          <p style="font-size:0.9rem;">Mon-Fri: 8am - 8pm AEST<br>Sat-Sun: 9am - 5pm AEST<br>Public Holidays: 10am - 4pm</p>
        </div>
      </div>
      <div class="card">
        <div class="card-body" style="text-align:center;padding:32px;">
          <div style="width:64px;height:64px;margin:0 auto 16px;border-radius:var(--radius-lg);background:var(--primary-alpha);display:flex;align-items:center;justify-content:center;font-size:2rem;">✉️</div>
          <h3 style="margin-bottom:8px;">Email</h3>
          <div style="font-size:1rem;font-weight:700;color:var(--primary);margin-bottom:4px;">support@unitedcreditbank.com.au</div>
          <p style="font-size:0.9rem;margin-top:12px;">General enquiries answered within 24 business hours. For urgent matters, please call us instead.</p>
        </div>
      </div>
      <div class="card">
        <div class="card-body" style="text-align:center;padding:32px;">
          <div style="width:64px;height:64px;margin:0 auto 16px;border-radius:var(--radius-lg);background:var(--primary-alpha);display:flex;align-items:center;justify-content:center;font-size:2rem;">💬</div>
          <h3 style="margin-bottom:8px;">Live Chat</h3>
          <div style="font-size:1rem;font-weight:700;color:var(--primary);margin-bottom:4px;">Chat with an agent now</div>
          <p style="font-size:0.9rem;margin-top:12px;">Available 8am - 10pm AEST daily. Tap the chat icon in the bottom right corner when logged in.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid-2" style="align-items:start;">
      <div>
        <span class="section-eyebrow">📝 Send us a Message</span>
        <h2 style="margin:12px 0 16px;">We'd love to hear from you.</h2>
        <p style="margin-bottom:24px;">Have a question, feedback, or complaint? Fill in the form and our team will get back to you within 24 business hours.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger">
            <span class="alert-icon">⚠️</span>
            <div class="alert-content"><div class="alert-title">Error</div><p class="alert-message"><%= error %></p></div>
          </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success">
            <span class="alert-icon">✓</span>
            <div class="alert-content"><div class="alert-title">Success</div><p class="alert-message"><%= success %></p></div>
          </div>
        <% } %>

        <form method="POST" action="/contact" class="card">
          <div class="card-body">
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label">First Name *</label>
                <input type="text" name="first_name" required class="form-input" placeholder="John">
              </div>
              <div class="form-group">
                <label class="form-label">Last Name *</label>
                <input type="text" name="last_name" required class="form-input" placeholder="Smith">
              </div>
            </div>
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label">Email *</label>
                <input type="email" name="email" required class="form-input" placeholder="john@example.com">
              </div>
              <div class="form-group">
                <label class="form-label">Phone</label>
                <input type="tel" name="phone" class="form-input" placeholder="0412 345 678">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Enquiry Type *</label>
              <select name="enquiry_type" required class="form-select">
                <option value="">Select type...</option>
                <option>General Enquiry</option>
                <option>Account Opening</option>
                <option>Loan Application</option>
                <option>Card Application</option>
                <option>Transfer Help</option>
                <option>Complaint</option>
                <option>Feedback</option>
                <option>Fraud Report</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Message *</label>
              <textarea name="message" required rows="5" class="form-textarea" placeholder="How can we help you?"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-lg btn-block">📤 Send Message</button>
          </div>
        </form>
      </div>

      <div>
        <div class="card" style="margin-bottom:20px;">
          <div class="card-header"><h3 class="card-title">🏢 Head Office</h3></div>
          <div class="card-body">
            <div style="display:flex;gap:12px;margin-bottom:16px;">
              <div style="width:40px;height:40px;border-radius:var(--radius-sm);background:var(--bg-gray);display:flex;align-items:center;justify-content:center;flex-shrink:0;">📍</div>
              <div>
                <div style="font-weight:700;">United Credit Bank Tower</div>
                <div style="color:var(--text-gray);font-size:0.9rem;">1 Martin Place<br>Sydney NSW 2000<br>Australia</div>
              </div>
            </div>
          </div>
        </div>

        <div class="card" style="margin-bottom:20px;">
          <div class="card-header"><h3 class="card-title">🚨 Emergency Contact</h3></div>
          <div class="card-body">
            <div class="alert alert-danger" style="margin-bottom:16px;">
              <span class="alert-icon">🚨</span>
              <div class="alert-content">
                <div class="alert-title">Lost or Stolen Card?</div>
                <p class="alert-message">Call our 24/7 emergency line immediately.</p>
              </div>
            </div>
            <div style="font-size:1.5rem;font-weight:800;color:var(--primary);">1800 822 265</div>
            <div style="font-size:0.85rem;color:var(--text-gray);">24 hours • 7 days a week • Free call within Australia</div>
            <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border);">
              <div style="font-size:0.9rem;font-weight:600;margin-bottom:4px;">🇦🇺 Overseas Emergency</div>
              <div style="font-size:1rem;font-weight:700;color:var(--primary);">+61 2 8000 0000</div>
              <div style="font-size:0.85rem;color:var(--text-gray);">Reverse charges accepted</div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h3 class="card-title">🏦 Our Branch Network</h3></div>
          <div class="card-body">
            <p style="font-size:0.9rem;margin-bottom:16px;">58 branches across Australia. Major locations include:</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:0.88rem;">
              <div>📍 Sydney CBD (HQ)</div>
              <div>📍 Sydney Bondi</div>
              <div>📍 Sydney Parramatta</div>
              <div>📍 Melbourne CBD</div>
              <div>📍 Melbourne Docklands</div>
              <div>📍 Brisbane CBD</div>
              <div>📍 Gold Coast</div>
              <div>📍 Adelaide CBD</div>
              <div>📍 Perth CBD</div>
              <div>📍 Hobart CBD</div>
              <div>📍 Darwin CBD</div>
              <div>📍 Canberra CBD</div>
            </div>
            <div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border);">
              <a href="#" class="service-link">View all 58 branches →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/layouts/main-end') -%>

