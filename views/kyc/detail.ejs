<%- include('../partials/layouts/user-start') -%>

<a href="/kyc" class="btn btn-outline btn-sm" style="margin-bottom:16px;">← KYC History</a>

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">🆔 Verification #<%= String(record.id).padStart(6, '0') %></h3>
      <span class="status-badge status-<%= record.status %>"><%= record.status.toUpperCase() %></span>
    </div>
    <div class="card-body">
      <% if (record.status === 'verified') { %>
        <div class="alert alert-success" style="margin-bottom:20px;">
          <span class="alert-icon">✅</span>
          <div class="alert-content">
            <div class="alert-title">Identity Verified!</div>
            <p class="alert-message" style="margin:0;">All banking features have been unlocked on your account.</p>
          </div>
        </div>
      <% } else if (record.status === 'rejected') { %>
        <div class="alert alert-danger" style="margin-bottom:20px;">
          <span class="alert-icon">❌</span>
          <div class="alert-content">
            <div class="alert-title">Could Not Verify</div>
            <p class="alert-message" style="margin:0;"><%= record.review_notes || 'Documents were unclear. Please re-submit with higher quality, in-colour, unexpired documents.' %></p>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-warning" style="margin-bottom:20px;">
          <span class="alert-icon">⏳</span>
          <div class="alert-content">
            <div class="alert-title">Under Review</div>
            <p class="alert-message" style="margin:0;">Our team is reviewing your documents. You'll be notified by email and notification once a decision is made.</p>
          </div>
        </div>
      <% } %>

      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-time"><%= moment(record.created_at).format('DD MMM, HH:mm') %></div>
          <div class="timeline-title">📝 Submitted</div>
          <div class="timeline-desc">Submitted <%= record.document_type %> verification.</div>
        </div>
        <% if (record.reviewed_at) { %>
          <div class="timeline-item">
            <div class="timeline-time"><%= moment(record.reviewed_at).format('DD MMM, HH:mm') %></div>
            <div class="timeline-title">
              <%= record.status === 'verified' ? '✅ Verified' : '❌ Rejected' %>
            </div>
            <div class="timeline-desc">
              Reviewed by admin. <%= record.review_notes ? 'Notes: ' + record.review_notes : '' %>
            </div>
          </div>
        <% } else { %>
          <div class="timeline-item">
            <div class="timeline-time">Awaiting review</div>
            <div class="timeline-title">⏳ In queue</div>
            <div class="timeline-desc">Expected within 4 business hours (Mon-Fri).</div>
          </div>
        <% } %>
      </div>

      <div style="padding-top:18px;border-top:1px solid var(--border);margin-top:12px;">
        <h4 style="margin:0 0 12px;">📄 Document Info</h4>
        <div style="display:grid;gap:10px;">
          <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);">
            <span style="color:var(--text-gray);">Type</span>
            <strong><%= record.document_type %></strong>
          </div>
          <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);">
            <span style="color:var(--text-gray);">Number</span>
            <strong style="font-family:monospace;"><%= record.document_number %></strong>
          </div>
          <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);">
            <span style="color:var(--text-gray);">Name on document</span>
            <strong><%= record.first_name %> <%= record.last_name %></strong>
          </div>
          <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);">
            <span style="color:var(--text-gray);">Date of Birth</span>
            <strong><%= moment(record.date_of_birth).format('DD MMM YYYY') %></strong>
          </div>
          <div style="display:flex;justify-content:space-between;padding:10px 0;">
            <span style="color:var(--text-gray);">Expiry Date</span>
            <strong><%= moment(record.expiry_date).format('DD MMM YYYY') %></strong>
          </div>
        </div>
      </div>

      <% if (record.status === 'rejected') { %>
        <div style="margin-top:18px;">
          <a href="/kyc/submit" class="btn btn-primary btn-block btn-lg">🔁 Re-Submit KYC</a>
        </div>
      <% } %>
    </div>
  </div>

  <div>
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header"><h3 class="card-title">🖼️ Document Preview</h3></div>
      <div class="card-body">
        <div style="display:grid;gap:14px;">
          <div style="aspect-ratio:1.586;background:var(--bg-gray);border:2px dashed var(--border);border-radius:var(--radius-lg);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--text-light);">
            <div style="font-size:2.5rem;margin-bottom:8px;">📄</div>
            <div style="font-weight:700;color:var(--text-gray);">Front Side</div>
            <div style="font-size:0.8rem;">Uploaded document</div>
          </div>
          <div style="aspect-ratio:1.586;background:var(--bg-gray);border:2px dashed var(--border);border-radius:var(--radius-lg);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--text-light);">
            <div style="font-size:2.5rem;margin-bottom:8px;">📄</div>
            <div style="font-weight:700;color:var(--text-gray);">Back Side</div>
            <div style="font-size:0.8rem;">Uploaded document</div>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">📞 Need Help?</h3></div>
      <div class="card-body">
        <div style="display:grid;gap:10px;">
          <a href="/user/support" class="btn btn-outline btn-block">💬 Live Chat with Support</a>
          <a href="tel:1300822265" class="btn btn-light btn-block">📞 Call 1300 UCBANK</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/layouts/user-end') -%>

