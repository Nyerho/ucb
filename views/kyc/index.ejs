<%- include('../partials/layouts/user-start') -%>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
  <div>
    <h2 style="margin:0;">🆔 Identity Verification (KYC)</h2>
    <p style="margin:4px 0 0;color:var(--text-gray);">Verify your identity to unlock full banking features.</p>
  </div>
  <a href="/kyc/submit" class="btn btn-primary btn-lg">➕ Submit New KYC</a>
</div>

<% if (latest) { %>
  <div class="card" style="margin-bottom:24px;">
    <div class="card-header">
      <h3 class="card-title">📌 Latest Verification</h3>
      <span class="status-badge status-<%= latest.status %>"><%= latest.status.toUpperCase() %></span>
    </div>
    <div class="card-body">
      <div class="alert alert-<%= latest.status === 'verified' ? 'success' : latest.status === 'rejected' ? 'danger' : 'warning' %>" style="margin-bottom:20px;">
        <span class="alert-icon"><%= latest.status === 'verified' ? '✅' : latest.status === 'rejected' ? '❌' : '⏳' %></span>
        <div class="alert-content">
          <div class="alert-title">
            <%= latest.status === 'verified' ? 'Identity Verified!' : latest.status === 'rejected' ? 'Verification Rejected' : 'Under Review' %>
          </div>
          <p class="alert-message" style="margin:0;">
            <%= latest.status === 'verified' ? 'Your account is fully verified. You have access to all banking features, higher limits, cards & loans.' :
                latest.status === 'rejected' ? 'Unfortunately your documents could not be verified: ' + (latest.review_notes || 'Please ensure documents are clear, in-colour, and not expired.') :
                'Our team is reviewing your documents. Typically completed within 4 business hours during weekdays.' %>
          </p>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));gap:12px;">
        <div style="padding:14px;background:var(--bg-gray);border-radius:var(--radius);">
          <div style="font-size:0.72rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">Document Type</div>
          <div style="font-weight:700;margin-top:4px;"><%= latest.document_type %></div>
        </div>
        <div style="padding:14px;background:var(--bg-gray);border-radius:var(--radius);">
          <div style="font-size:0.72rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">Document #</div>
          <div style="font-weight:700;margin-top:4px;"><%= latest.document_number || '—' %></div>
        </div>
        <div style="padding:14px;background:var(--bg-gray);border-radius:var(--radius);">
          <div style="font-size:0.72rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">Expiry</div>
          <div style="font-weight:700;margin-top:4px;"><%= latest.expiry_date ? moment(latest.expiry_date).format('DD MMM YYYY') : '—' %></div>
        </div>
        <div style="padding:14px;background:var(--bg-gray);border-radius:var(--radius);">
          <div style="font-size:0.72rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">Submitted</div>
          <div style="font-weight:700;margin-top:4px;"><%= moment(latest.created_at).format('DD MMM YYYY') %></div>
        </div>
      </div>
      <div style="margin-top:14px;text-align:right;">
        <a href="/kyc/<%= latest.id %>" class="btn btn-outline btn-sm">View Details →</a>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="card" style="margin-bottom:24px;">
    <div class="card-body">
      <div class="empty-state">
        <div class="empty-state-icon">🆔</div>
        <h4>Verify your identity</h4>
        <p>Complete KYC verification to unlock card applications, loans, higher transaction limits, and international transfers.</p>
        <a href="/kyc/submit" class="btn btn-primary btn-lg" style="margin-top:16px;">🚀 Start Verification</a>
      </div>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header">
    <h3 class="card-title">📋 KYC History</h3>
    <span style="font-size:0.85rem;color:var(--text-light);"><%= records.length %> submission(s)</span>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Document Type</th>
          <th>Document #</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (records.length === 0) { %>
          <tr><td colspan="5"><div class="empty-state" style="padding:36px 20px;"><div class="empty-state-icon" style="width:56px;height:56px;font-size:1.5rem;">📋</div><h4>No submissions yet</h4></div></td></tr>
        <% } %>
        <% records.forEach(r => { %>
          <tr style="cursor:pointer;" onclick="location.href='/kyc/<%= r.id %>'">
            <td><%= moment(r.created_at).format('DD MMM YYYY') %></td>
            <td>
              <div style="font-weight:600;font-size:0.9rem;"><%= r.document_type %></div>
            </td>
            <td style="font-family:monospace;font-size:0.85rem;"><%= r.document_number || '—' %></td>
            <td><span class="status-badge status-<%= r.status %>"><%= r.status %></span></td>
            <td onclick="event.stopPropagation();"><a href="/kyc/<%= r.id %>" class="btn btn-light btn-sm">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layouts/user-end') -%>

