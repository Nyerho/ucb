  <div class="sidebar-footer">
    <div class="user-chip">
      <div class="user-avatar" style="background: linear-gradient(135deg, #1A1A2E, #C8102E);"><%= typeof user !== 'undefined' ? (user.first_name || 'A').charAt(0) : 'A' %></div>
      <div class="user-chip-info">
        <div class="user-chip-name"><%= typeof user !== 'undefined' ? user.first_name + ' ' + user.last_name : 'Admin' %></div>
        <div class="user-chip-email" style="color:var(--primary);font-weight:600;">⚙️ Administrator</div>
      </div>
    </div>
    <a href="/auth/logout" class="sidebar-link" style="margin-top:8px;">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Logout
