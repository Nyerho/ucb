<aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
  <div class="offcanvas-header d-lg-none">
    <div>
      <div class="fw-bold" id="appSidebarLabel">Admin Console</div>
      <div class="text-muted small">Responsive operations menu</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="sidebar-brand">
    <a href="/admin/dashboard" class="brand" style="text-decoration:none;">
      <div class="brand-logo" style="background: linear-gradient(135deg, #1A1A2E 0%, #C8102E 100%);">A</div>
      <div class="brand-text">
        <span class="brand-name">Admin Console</span>
        <span class="brand-tag">🇦🇺 United Credit Bank</span>
      </div>
    </a>
  </div>
  <nav class="sidebar-menu">
    <div class="sidebar-section">
      <div class="sidebar-section-title">Overview</div>
      <a href="/admin/dashboard" class="sidebar-link <%= page === 'admin-dashboard' ? 'active' : '' %>">
