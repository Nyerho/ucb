        Dashboard
      </a>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-section-title">Approvals</div>
      <a href="/admin/approvals" class="sidebar-link <%= page === 'admin-approvals' ? 'active' : '' %>">
