<aside class="sidebar offcanvas offcanvas-lg offcanvas-start" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
  <div class="offcanvas-header d-lg-none">
    <div>
      <div class="fw-bold" id="appSidebarLabel">United Credit Bank</div>
      <div class="text-muted small">Digital banking menu</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="sidebar-brand">
    <a href="/user/dashboard" class="brand" style="text-decoration:none;">
      <div class="brand-logo">UCB</div>
      <div class="brand-text">
        <span class="brand-name">United Credit</span>
        <span class="brand-tag">🇦🇺 Digital Banking</span>
      </div>
    </a>
  </div>
  <nav class="sidebar-menu">
    <div class="sidebar-section">
      <div class="sidebar-section-title">Main</div>
      <a href="/user/dashboard" class="sidebar-link <%= page === 'dashboard' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Dashboard
      </a>
      <a href="/accounts" class="sidebar-link <%= page === 'accounts' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        My Accounts
      </a>
      <a href="/user/statements" class="sidebar-link <%= page === 'statements' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Statements
      </a>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-section-title">Transfers & Payments</div>
      <a href="/transfers" class="sidebar-link <%= page === 'transfers' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        Transfers
        <% if (typeof pendingTransfers !== 'undefined' && pendingTransfers > 0) { %>
          <span class="sidebar-badge"><%= pendingTransfers %></span>
        <% } %>
      </a>
      <a href="/billpay" class="sidebar-link <%= page === 'billpay' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"/></svg>
        Bill Payments
      </a>
      <a href="/billpay/deposit/new" class="sidebar-link">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
        Deposit Funds
      </a>
      <a href="/billpay/withdraw/new" class="sidebar-link">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
        Withdraw Funds
      </a>
      <a href="/user/beneficiaries" class="sidebar-link <%= page === 'beneficiaries' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        Beneficiaries
      </a>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-section-title">Products</div>
      <a href="/cards" class="sidebar-link <%= page === 'cards' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        Cards
        <% if (typeof pendingCards !== 'undefined' && pendingCards > 0) { %>
          <span class="sidebar-badge"><%= pendingCards %></span>
        <% } %>
      </a>
      <a href="/loans" class="sidebar-link <%= page === 'loans' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Loans
        <% if (typeof pendingLoans !== 'undefined' && pendingLoans > 0) { %>
          <span class="sidebar-badge"><%= pendingLoans %></span>
        <% } %>
      </a>
      <a href="/kyc" class="sidebar-link <%= page === 'kyc' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/></svg>
        Identity (KYC)
      </a>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-section-title">Account</div>
      <a href="/user/profile" class="sidebar-link <%= page === 'profile' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        My Profile
      </a>
      <a href="/user/notifications" class="sidebar-link <%= page === 'notifications' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        Notifications
      </a>
      <a href="/user/settings" class="sidebar-link <%= page === 'settings' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Settings
      </a>
      <a href="/user/support" class="sidebar-link <%= page === 'support' ? 'active' : '' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        Support & Help
      </a>
    </div>
  </nav>
  <div class="sidebar-footer">
    <div class="user-chip">
      <div class="user-avatar"><%= typeof user !== 'undefined' ? (user.first_name || 'U').charAt(0) + (user.last_name || '').charAt(0) : 'U' %></div>
      <div class="user-chip-info">
        <div class="user-chip-name"><%= typeof user !== 'undefined' ? user.first_name + ' ' + user.last_name : 'User' %></div>
        <div class="user-chip-email"><%= typeof user !== 'undefined' ? user.email : '' %></div>
      </div>
    </div>
    <a href="/auth/logout" class="sidebar-link" style="margin-top:8px;">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Logout
    </a>
  </div>
</aside>
