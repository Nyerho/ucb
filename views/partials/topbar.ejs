<header class="topbar">
  <div class="topbar-left">
    <button class="btn btn-light d-lg-none topbar-menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar">
      ☰
    </button>
    <h1 class="page-title" id="pageTitle"><%= typeof pageTitle !== 'undefined' ? pageTitle : title.split(' - ')[0] %></h1>
  </div>
  <div class="topbar-actions">
    <div class="search-input-wrap d-none d-md-block" style="width:260px;">
      <span class="search-icon">🔍</span>
      <input type="text" class="form-input" placeholder="Search..." id="topbarSearch">
    </div>
    <button class="notification-btn" id="notifBtn" title="Notifications">
      🔔
      <span class="notification-dot" id="notifDot" style="display:none;"></span>
    </button>
    <div class="dropdown">
      <button class="user-chip" id="userDropBtn" style="background:none;border:none;cursor:pointer;">
        <div class="user-avatar"><%= typeof user !== 'undefined' ? (user.first_name || 'U').charAt(0) + (user.last_name || '').charAt(0) : 'U' %></div>
        <div class="user-chip-info">
          <div class="user-chip-name"><%= typeof user !== 'undefined' ? user.first_name + ' ' + user.last_name : 'User' %></div>
          <div class="user-chip-email">My Account ▾</div>
        </div>
      </button>
      <div class="dropdown-menu" id="userDropMenu">
        <a href="/user/profile" class="dropdown-item">👤 My Profile</a>
        <a href="/user/settings" class="dropdown-item">⚙️ Settings</a>
        <a href="/user/notifications" class="dropdown-item">🔔 Notifications</a>
        <div style="height:1px;background:var(--border);margin:6px 0;"></div>
        <a href="/auth/logout" class="dropdown-item danger">🚪 Logout</a>
      </div>
    </div>
  </div>
</header>
