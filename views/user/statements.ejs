<% const pageScripts = ['/js/transfers.js']; %>
<%- include('../partials/layouts/user-start') -%>

<div class="card" style="margin-bottom:20px;">
  <div class="card-header">
    <h3 class="card-title">📊 Account Statement</h3>
    <div style="display:flex;gap:8px;">
      <select id="accountSelect" class="form-select" style="min-width:240px;">
        <% accounts.forEach(acc => { %>
          <option value="<%= acc.id %>" <%= selectedAccount && selectedAccount.id === acc.id ? 'selected' : '' %>>
            <%= acc.account_type %> • <%= currency(acc.balance) %>
          </option>
        <% }) %>
      </select>
      <a href="#" class="btn btn-outline btn-sm" onclick="window.print();return false;">🖨️ Print</a>
      <button class="btn btn-outline btn-sm">⬇️ Export CSV</button>
    </div>
  </div>
  <% if (selectedAccount) { %>
    <div class="filter-bar">
      <div class="filter-group">
        <span class="filter-label">From Date</span>
        <input type="date" class="form-input" id="fromDate">
      </div>
      <div class="filter-group">
        <span class="filter-label">To Date</span>
        <input type="date" class="form-input" id="toDate">
      </div>
      <div class="filter-group">
        <span class="filter-label">Type</span>
        <select class="form-select" id="typeFilter">
          <option value="all">All Types</option>
          <option>deposit</option>
          <option>withdrawal</option>
          <option>local_transfer</option>
          <option>international_transfer</option>
          <option>bill_payment</option>
          <option>loan_payment</option>
          <option>loan_disbursement</option>
        </select>
      </div>
      <button class="btn btn-primary btn-sm" onclick="filterStatement()">🔍 Filter</button>
    </div>
  <% } %>
  <% if (selectedAccount) { %>
    <div style="padding:20px 24px;background:var(--bg-light);border-bottom:1px solid var(--border);">
      <div class="grid-4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;">
        <div>
          <div style="font-size:0.75rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">Account</div>
          <div style="font-weight:700;font-size:1rem;margin-top:4px;"><%= selectedAccount.account_type %></div>
          <div style="font-size:0.85rem;color:var(--text-gray);font-family:monospace;">BSB <%= selectedAccount.bsb %> • <%= selectedAccount.account_number %></div>
        </div>
        <div>
          <div style="font-size:0.75rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">Current Balance</div>
          <div style="font-weight:800;font-size:1.5rem;color:var(--text-dark);margin-top:4px;"><%= currency(selectedAccount.balance) %></div>
        </div>
        <div>
          <div style="font-size:0.75rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">Total Credits</div>
          <div style="font-weight:700;font-size:1.25rem;color:var(--success);margin-top:4px;">
            +<%= currency(transactions.filter(t => ['deposit','loan_disbursement'].includes(t.transaction_type) && t.status==='completed').reduce((s,t)=>s+Math.abs(parseFloat(t.amount)),0)) %>
          </div>
        </div>
        <div>
          <div style="font-size:0.75rem;color:var(--text-light);text-transform:uppercase;letter-spacing:0.05em;">Total Debits</div>
          <div style="font-weight:700;font-size:1.25rem;color:var(--danger);margin-top:4px;">
            -<%= currency(transactions.filter(t => ['withdrawal','local_transfer','international_transfer','bill_payment','loan_payment'].includes(t.transaction_type) && t.status==='completed').reduce((s,t)=>s+Math.abs(parseFloat(t.amount)),0)) %>
          </div>
        </div>
      </div>
    </div>
  <% } %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Type / Description</th>
          <th>Reference</th>
          <th style="text-align:right;">Amount</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (transactions.length === 0) { %>
          <tr><td colspan="5"><div class="empty-state"><div class="empty-state-icon">📋</div><h4>No transactions</h4><p>No transactions found for this period.</p></div></td></tr>
        <% } %>
        <% transactions.forEach(tx => { 
          const isOut = ['withdrawal','local_transfer','international_transfer','bill_payment','loan_payment','admin_adjustment'].includes(tx.transaction_type) && parseFloat(tx.amount) < 0 || ['withdrawal','local_transfer','international_transfer','bill_payment','loan_payment'].includes(tx.transaction_type);
          const displayType = tx.transaction_type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        %>
          <tr style="cursor:pointer;" onclick="location.href='/transfers/<%= tx.id %>'">
            <td><%= moment(tx.created_at).format('DD MMM YYYY HH:mm') %></td>
            <td>
              <div style="font-weight:600;font-size:0.9rem;"><%= tx.recipient_name || tx.description || displayType %></div>
              <div style="font-size:0.8rem;color:var(--text-light);"><%= displayType %></div>
            </td>
            <td style="font-family:monospace;font-size:0.85rem;"><%= tx.reference || '—' %></td>
            <td style="text-align:right;">
              <div style="font-weight:700;color:<%= isOut ? 'var(--danger)' : 'var(--success)' %>">
                <%= isOut ? '-' : '+' %><%= currency(Math.abs(parseFloat(tx.amount))) %>
              </div>
              <% if (parseFloat(tx.fee) > 0) { %>
                <div style="font-size:0.75rem;color:var(--text-light);">Fee: <%= currency(tx.fee) %></div>
              <% } %>
            </td>
            <td><span class="status-badge status-<%= tx.status %>"><%= tx.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layouts/user-end', { pageScripts }) -%>


